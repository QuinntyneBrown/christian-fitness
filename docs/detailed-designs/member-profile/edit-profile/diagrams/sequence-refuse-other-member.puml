@startuml
title UML sequence behaviour — Request to change another member's profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "Client" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "UpdateProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> client : Craft request for another member's id
client -> ctrl : PUT /api/members/{otherId}/profile
ctrl -> h : Send UpdateProfileCommand(otherId)
h -> h : otherId is not the session's member (L2-006 AC5)
h --> ctrl : RefusalException(forbidden, Forbidden)
ctrl --> client : 403 ProblemDetails, code forbidden
note over db : No read or write of any member; the same answer whether otherId exists or not (L2-031 AC3)
@enduml
