@startuml
title UML sequence behaviour — Request to change another member's profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "Client" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "UpdateProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> client : Craft request for another member's id
client -> ctrl : PUT profile of member {otherId}
ctrl -> h : Send UpdateProfileCommand(caller id, target id)
h -> h : Target differs from caller (L2-006 AC5)
h --> ctrl : Forbidden
ctrl --> client : 403 ProblemDetails, code <TO SUPPLY>
note over db : No read or write of the target member
@enduml
