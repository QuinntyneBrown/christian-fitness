@startuml
title UML sequence behaviour — Member edits own profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ProfilePage" as page
  participant "EditProfileDialog" as dlg
  participant "HttpProfileService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "UpdateProfileValidator" as v
  participant "UpdateProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Choose Edit profile
page -> page : import() EditProfileDialog (first use only), open it in a CDK Dialog with the screen's injector
page -> dlg : Open with current values, focus Full name (L2-006 AC1)
actor -> dlg : Change fields (church visibility is set in Preferences, AC4)
actor -> dlg : Save changes
alt validateProfile names a field (AC6)
  dlg --> actor : Error summary and inline errors; nothing sent
else Valid in the dialog
  dlg --> actor : "Saving…", fields read-only, Cancel and Escape held
  dlg -> client : update(memberId, UpdateProfileDto)
  client -> ctrl : PUT /api/members/{memberId}/profile
  ctrl -> v : Validate UpdateProfileCommand
  alt Over a limit or too many goals (AC3)
    v --> ctrl : field_too_long or too_many_goals
    ctrl --> client : 400 ProblemDetails with code
    client --> dlg : ApiError
    dlg --> actor : "Check your profile", values kept (AC7)
  else Valid
    ctrl -> h : Send UpdateProfileCommand
    h -> h : memberId is the session's member
    h -> db : Load caller Member
    db --> h : Member
    h -> h : Member.EditProfile(...)
    h -> db : Save once
    db --> h : Saved
    h --> ctrl : OwnProfileDto
    ctrl --> client : 200 JSON
    client --> dlg : Saved profile
    dlg -> page : closed with the saved profile (AC2)
    page --> actor : Show new values; focus back on Edit profile
  end
end
@enduml
