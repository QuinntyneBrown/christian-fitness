@startuml
title UML sequence behaviour — Member edits own profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ProfilePage" as page
  participant "EditProfileDialog" as dlg
  participant "HttpProfileService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "UpdateProfileValidator" as v
  participant "UpdateProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Choose Edit profile
page -> dlg : Open CDK Dialog with current values (L2-006 AC1)
actor -> dlg : Change fields, choose home church visibility (default hidden, L2-006 AC4)
actor -> dlg : Save
dlg --> actor : Busy state
dlg -> client : update(UpdateProfileDto)
client -> ctrl : PUT /api/profile/me
ctrl -> v : Validate UpdateProfileCommand
alt Bio > 300, goal > 80 or more than 5 goals (L2-006 AC3)
  v --> ctrl : field_too_long or too_many_goals
  ctrl --> client : 400 ProblemDetails with code
  client --> dlg : Error code
  dlg --> actor : Invalid state; nothing changes
else Valid
  ctrl -> h : Send UpdateProfileCommand(caller id from session)
  h -> db : Load caller Member
  db --> h : Member
  h -> h : Apply changes
  h -> db : Save in one unit of work
  db --> h : Saved
  h --> ctrl : OwnProfileDto
  ctrl --> client : 200 JSON
  client --> dlg : Updated profile
  dlg -> page : Close by DialogRef with result (L2-006 AC2)
  page --> actor : Show new values
end
@enduml
