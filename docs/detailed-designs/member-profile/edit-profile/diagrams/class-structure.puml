@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit own profile
class ProfilePage {
  -profile: Signal<ProfileView|null>
  #edit(): Promise<void>
}
class EditProfileDialog {
  -fieldErrors: Signal<ProfileFieldErrors>
  -refusal: Signal<ProfileRefusal|null>
  -saving: Signal<boolean>
  #save(): void
  #dismiss(): void
}
class "profile-rules" as rules <<@cf/domain>> {
  +validateProfile(form): ProfileFieldErrors
  +profileRequestOf(form): UpdateProfileDto
  +profileRefusalOf(error): ProfileRefusal
}
class UpdateProfileDto {
  +name: string
  +city: string|null
  +homeChurch: string|null
  +bio: string|null
  +goals: string[]
  +interests: string[]
}
interface ProfileApi {
  +own(): Observable<OwnProfileDto>
  +update(memberId, dto: UpdateProfileDto): Observable<OwnProfileDto>
}
class HttpProfileService
class ProfileController {
  +Update(memberId, command): Task<IActionResult>
}
class UpdateProfileCommand {
  +Guid MemberId
  +string Name
  +string? City
  +string? HomeChurch
  +string? Bio
  +IReadOnlyList<string> Goals
  +IReadOnlyList<string> Interests
}
class UpdateProfileValidator
class UpdateProfileHandler {
  +Handle(c: UpdateProfileCommand): Task<OwnProfileDto>
}
class Member {
  +string Name
  +string? City
  +string? Bio
  +string? HomeChurch
  +bool ShowHomeChurch = false
  +IReadOnlyList<string> Goals
  +IReadOnlyList<string> Interests
  +EditProfile(...): void
}
ProfilePage ..> EditProfileDialog : opens (import(), CDK Dialog)
EditProfileDialog ..> ProfileApi : injects PROFILE_SERVICE
EditProfileDialog ..> rules
rules ..> UpdateProfileDto
HttpProfileService ..|> ProfileApi
HttpProfileService ..> ProfileController : PUT /api/members/{memberId}/profile
ProfileController ..> UpdateProfileCommand : sends
UpdateProfileValidator ..> UpdateProfileCommand : validates
UpdateProfileHandler ..> UpdateProfileCommand : handles
UpdateProfileHandler --> Member : EditProfile
@enduml
