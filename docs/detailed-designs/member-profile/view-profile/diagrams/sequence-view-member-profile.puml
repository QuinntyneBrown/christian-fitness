@startuml
title UML sequence behaviour — Member views another member's profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "MemberProfilePage" as page
  participant "HttpProfileService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetPublicProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Open another member's profile URL
page -> client : publicProfile(id)
client -> ctrl : GET /api/members/{id}/profile
ctrl -> h : Send GetPublicProfileQuery
h -> db : Load Member by id
db --> h : Member
h -> h : Project name, initials, bio, interests; never email (L2-005 AC3)
opt ShowHomeChurch is true (L2-006 AC4)
  h -> h : Add homeChurch
end
h --> ctrl : PublicProfileDto
ctrl --> client : 200 JSON
client --> page : Public profile
page --> actor : Render public fields only
@enduml
