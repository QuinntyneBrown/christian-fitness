@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View a profile
class ProfilePage {
  +profile: Signal<OwnProfileDto|null>
  +state: Signal<'loading'|'loaded'|'failed'>
  +retry(): void
  +edit(): void
}
class ProfileHero {
  +name, initials, meta: input<string>
  +homeChurch, city: input<string|null>
  +loading: input<boolean>
  [slot=action]: Edit profile, Preferences
}
class Button {
  +variant: input<string>
  +href: input<string|undefined>
}
class MemberProfilePage {
  +profile: Signal<PublicProfileDto|null>
}
interface ProfileApi {
  +own(): Observable<OwnProfileDto>
  +publicProfile(id: string): Observable<PublicProfileDto>
}
class HttpProfileService
class OwnProfileDto {
  +name: string
  +city: string|null
  +joinedAt: string
  +bio: string|null
  +homeChurch: string|null
  +goals: string[]
  +interests: string[]
  +upcomingEvents: UpcomingEventDto[]
}
class UpcomingEventDto {
  +eventId: string
  +title: string
  +startsAt: string
  +imageUrl: string|null
}
class PublicProfileDto {
  +name: string
  +bio: string|null
  +interests: string[]
  +homeChurch?: string
}
class GetOwnProfileHandler
class GetPublicProfileHandler
interface IRegistrationReader {
  +UpcomingForAsync(memberId, now): UpcomingEventDto[]
}
class DatabaseRegistrations
class Member {
  +Guid Id
  +string Name
  +string? City
  +string? Bio
  +string? HomeChurch
  +bool ShowHomeChurch
  +IReadOnlyList<string> Goals
  +IReadOnlyList<string> Interests
  +DateTimeOffset JoinedAt
}
class Registration {
  +Guid MemberId
  +Guid EventId
}
HttpProfileService ..|> ProfileApi
ProfilePage ..> ProfileApi : injects PROFILE_SERVICE
MemberProfilePage ..> ProfileApi : injects PROFILE_SERVICE
OwnProfileDto *-- UpcomingEventDto
ProfilePage --> ProfileHero
ProfileHero --> "2" Button : projected actions
GetOwnProfileHandler ..> Member
GetOwnProfileHandler ..> IRegistrationReader
DatabaseRegistrations ..|> IRegistrationReader
DatabaseRegistrations ..> Registration : reads
GetOwnProfileHandler ..> OwnProfileDto : returns
GetPublicProfileHandler ..> Member
GetPublicProfileHandler ..> PublicProfileDto : returns
Member "1" --> "*" Registration
@enduml
