@startuml
title UML sequence behaviour — Member views own profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ProfilePage" as page
  participant "HttpProfileService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ProfileController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetOwnProfileHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Open /profile
page --> actor : Show skeleton
page -> client : own()
client -> ctrl : GET /api/profile/me
ctrl -> h : Send GetOwnProfileQuery(caller id)
h -> db : Load caller Member and upcoming Registration rows
db --> h : Member, events
h --> ctrl : OwnProfileDto
ctrl --> client : 200 JSON
client --> page : Profile
alt Has upcoming events (L2-005 AC1)
  page --> actor : Name, initials avatar, city, join date, bio, church, goals, interests, events
else No events (L2-005 AC2)
  page --> actor : Empty state with link to Events
end
@enduml
