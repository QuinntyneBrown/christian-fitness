@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Admin sign-in

interface StaffSessionApi {
  +current(): Observable<StaffSessionDto>
  +startGoogle(): Observable<GoogleRedirectDto>
  +completeGoogle(): Observable<StaffSessionDto>
  +signOut(): Observable<void>
}
class HttpStaffSessionService
class SignInPage {
  -redirecting: WritableSignal<boolean>
  -refusal: WritableSignal<StaffSignInRefusal | null>
  +startGoogle(): void
}
class "staffSignInRefusalOf()" as refusalOf {
  +(error): wrong-domain | not-staff | failed
}
class "googleReturnOf()" as returnOf
class "sessionEndingOf()" as sessionEndingOf
class "staffAuthGuard" as guard
class "sessionExpiredInterceptor" as expiredIcpt
class "forbiddenInterceptor" as forbiddenIcpt
class ForbiddenPage {
  -signingOut: WritableSignal<boolean>
  +signOut(): void
}
class GoogleButton <<components>>
class SsoNotice <<components>>
class StaffLayout <<components>>
class CompleteStaffGoogleSignInCommand <<IAuditableCommand>> {
  AuditAction = staff_session.started
}
class CompleteStaffGoogleSignInHandler {
  +Handle(cmd): Task<StaffSessionDto>
}
interface IGoogleIdentityReader {
  +ReadAsync(): Task<GoogleIdentity?>
  +ForgetAsync(): Task
}
class GoogleIdentity <<record>> {
  +string Subject
  +string Email
  +bool EmailVerified
  +string? HostedDomain
}
class GoogleAccountMatch {
  +FindAsync(identity): Task<Member?>
}
class GoogleOptions {
  +string ClientId
  +string ClientSecret
  +string StaffDomain
}
class StaffSessionDto {
  +Guid MemberId
  +string Name
  +string Role
}
interface IStaffSessionSignIn {
  +SignInAsync(member, role): Task
  +SignOutAsync(): Task
}
class CookieStaffSessionSignIn {
  StaffIdleTimeout = 30 minutes
  StaffSessionMaxAge = 12 hours
}
class DatabaseTicketStore
class Member {
  +Guid Id
  +string NormalizedEmail
  +string? GoogleSubject
  +MemberStatus Status
}
class StaffRole {
  +Guid MemberId
  +StaffRoleName Name
}
enum StaffRoleName {
  Admin
  Moderator
}

HttpStaffSessionService ..|> StaffSessionApi
SignInPage ..> StaffSessionApi : injects STAFF_SESSION_SERVICE
SignInPage ..> refusalOf : chooses the notice
SignInPage ..> returnOf : google=returned or failed
SignInPage ..> sessionEndingOf : reads the notice once
SignInPage --> StaffLayout
SignInPage --> GoogleButton
SignInPage --> SsoNotice
guard ..> StaffSessionApi : current()
expiredIcpt ..> SignInPage : opens with { session: 'expired' }
forbiddenIcpt ..> ForbiddenPage : opens on a 403 to a GET
ForbiddenPage ..> StaffSessionApi : signOut()
CompleteStaffGoogleSignInHandler ..> CompleteStaffGoogleSignInCommand : handles
CompleteStaffGoogleSignInHandler ..> IGoogleIdentityReader : reads, forgets
IGoogleIdentityReader ..> GoogleIdentity
CompleteStaffGoogleSignInHandler ..> GoogleOptions : StaffDomain vs hd
CompleteStaffGoogleSignInHandler ..> GoogleAccountMatch
CompleteStaffGoogleSignInHandler ..> StaffRole : none = not_staff
CompleteStaffGoogleSignInHandler ..> IStaffSessionSignIn : signs in
CompleteStaffGoogleSignInHandler ..> StaffSessionDto : returns
GoogleAccountMatch ..> Member
CookieStaffSessionSignIn ..|> IStaffSessionSignIn
CookieStaffSessionSignIn ..> DatabaseTicketStore : session kept on the server
Member "1" --> "0..1" StaffRole
StaffRole --> StaffRoleName
@enduml
