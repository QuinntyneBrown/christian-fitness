@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Admin sign-in

interface StaffSessionApi {
  +current(): Observable<StaffSessionDto>
  +signIn(request: SignInRequestDto): Observable<StaffSessionDto>
  +signOut(): Observable<void>
}
class HttpStaffSessionService
class SignInPage {
  -email: WritableSignal<string>
  -password: WritableSignal<string>
  -submitting: WritableSignal<boolean>
  -refusal: WritableSignal<StaffSignInRefusal | null>
  +submit(): void
}
class "staffSignInRefusalOf()" as refusalOf
class "staffAuthGuard" as guard
class StaffSignInCommand {
  +string Email
  +string Password
}
class StaffSignInHandler {
  +Handle(cmd): Task<StaffSessionDto>
}
class MemberCredentials {
  +VerifyAsync(email, password): Task<Member>
}
class StaffSessionDto {
  +Guid MemberId
  +string Name
  +string Role
}
interface IStaffSessionSignIn {
  +SignInAsync(member, role): Task
  +SignOutAsync(): Task
}
class CookieStaffSessionSignIn
class DatabaseTicketStore
class Member {
  +Guid Id
  +string NormalizedEmail
  +string PasswordHash
}
class StaffRole {
  +Guid MemberId
  +StaffRoleName Name
}
enum StaffRoleName {
  Admin
  Moderator
}
interface IPasswordHasherService {
  +Verify(hash: string, password: string): bool
}
interface IAppDbContext

HttpStaffSessionService ..|> StaffSessionApi
SignInPage ..> StaffSessionApi : injects STAFF_SESSION_SERVICE
SignInPage ..> refusalOf : chooses the alert
guard ..> StaffSessionApi : current()
StaffSignInHandler ..> StaffSignInCommand : handles
StaffSignInHandler ..> MemberCredentials : verifies
StaffSignInHandler ..> IAppDbContext : reads StaffRole
StaffSignInHandler ..> IStaffSessionSignIn : signs in
StaffSignInHandler ..> StaffSessionDto : returns
MemberCredentials ..> IAppDbContext
MemberCredentials ..> IPasswordHasherService
CookieStaffSessionSignIn ..|> IStaffSessionSignIn
CookieStaffSessionSignIn ..> DatabaseTicketStore : session kept on the server
Member "1" --> "0..1" StaffRole
StaffRole --> StaffRoleName
@enduml
