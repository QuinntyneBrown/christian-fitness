@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Admin sign-in

interface StaffSessionApi {
  +current(): Observable<StaffSessionDto>
  +signIn(request: SignInRequestDto): Observable<void>
  +verify(request: TwoStepRequestDto): Observable<StaffSessionDto>
  +signOut(): Observable<void>
}
class HttpStaffSessionService
class SignInPage {
  -email: WritableSignal<string>
  -password: WritableSignal<string>
  -submitting: WritableSignal<boolean>
  -refusal: WritableSignal<StaffSignInRefusal | null>
  +submit(): void
}
class "staffSignInRefusalOf()" as refusalOf
class TwoStepPage {
  -code: WritableSignal<string>
  -submitting: WritableSignal<boolean>
  -refusal: WritableSignal<TwoStepRefusal | null>
  +submit(): void
}
class "twoStepRefusalOf()" as twoStepRefusalOf
class "staffAuthGuard" as guard
class "sessionExpiredInterceptor" as expiredIcpt
class "sessionEndingOf()" as sessionEndingOf
class "forbiddenInterceptor" as forbiddenIcpt
class ForbiddenPage {
  -signingOut: WritableSignal<boolean>
  +signOut(): void
}
class SignInFailure {
  +{static} Attempts: AttemptWindow(5, 15 minutes)
  +string EmailKey
  +DateTimeOffset FailedAt
}
class StaffSignInCommand {
  +string Email
  +string Password
}
class StaffSignInHandler {
  +Handle(cmd): Task
}
class VerifyTwoStepCommand {
  +string Code
}
class VerifyTwoStepHandler {
  +Handle(cmd): Task<StaffSessionDto>
}
interface ITwoStepCookie {
  +Issue(token, expiresAt): void
  +Read(): string?
  +Clear(): void
}
class CookieTwoStepCookie
class StaffTwoStep {
  +Guid MemberId
  +byte[] Secret
  +long LastUsedStep
  +TryUse(code, now): bool
}
class TwoStepChallenge {
  +{static} Lifetime: 5 minutes
  +{static} FailureWindow: AttemptWindow(5, 15 minutes)
  +string TokenHash
  +DateTimeOffset ExpiresAt
}
class TwoStepFailure {
  +Guid MemberId
  +DateTimeOffset FailedAt
}
class "Totp" as totp {
  +{static} Match(secret, code, now, lastUsedStep): long?
}
class AttemptWindow {
  +int Limit
  +TimeSpan Period
  +IsFull(attemptsSince): bool
}
class MemberCredentials {
  +VerifyAsync(email, password): Task<Member>
  +ForgetFailuresAsync(email): Task
}
class StaffSessionDto {
  +Guid MemberId
  +string Name
  +string Role
}
interface IStaffSessionSignIn {
  +SignInAsync(member, role): Task
  +SignOutAsync(): Task
}
class CookieStaffSessionSignIn
class DatabaseTicketStore
class Member {
  +Guid Id
  +string NormalizedEmail
  +string PasswordHash
}
class StaffRole {
  +Guid MemberId
  +StaffRoleName Name
}
enum StaffRoleName {
  Admin
  Moderator
}
interface IPasswordHasherService {
  +Verify(hash: string, password: string): bool
}
interface IAppDbContext

HttpStaffSessionService ..|> StaffSessionApi
SignInPage ..> StaffSessionApi : injects STAFF_SESSION_SERVICE
SignInPage ..> refusalOf : chooses the alert
guard ..> StaffSessionApi : current()
expiredIcpt ..> SignInPage : opens with { session: 'expired' }
SignInPage ..> sessionEndingOf : reads the notice once
forbiddenIcpt ..> ForbiddenPage : opens on a 403 to a GET
ForbiddenPage ..> StaffSessionApi : signOut()
StaffSignInHandler ..> StaffSignInCommand : handles
StaffSignInHandler ..> MemberCredentials : verifies
StaffSignInHandler ..> IAppDbContext : reads StaffRole
StaffSignInHandler ..> TwoStepChallenge : issues
StaffSignInHandler ..> ITwoStepCookie : sets the step cookie
TwoStepPage ..> StaffSessionApi : verify()
TwoStepPage ..> twoStepRefusalOf : chooses the message
VerifyTwoStepHandler ..> VerifyTwoStepCommand : handles
VerifyTwoStepHandler ..> ITwoStepCookie : reads, clears
VerifyTwoStepHandler ..> TwoStepFailure : counts, records
VerifyTwoStepHandler ..> StaffTwoStep : TryUse(code)
VerifyTwoStepHandler ..> IStaffSessionSignIn : signs in
VerifyTwoStepHandler ..> StaffSessionDto : returns
TwoStepChallenge ..> AttemptWindow
StaffTwoStep ..> totp
CookieTwoStepCookie ..|> ITwoStepCookie
MemberCredentials ..> IAppDbContext
MemberCredentials ..> SignInFailure : counts, records, forgets
SignInFailure ..> AttemptWindow
MemberCredentials ..> IPasswordHasherService
CookieStaffSessionSignIn ..|> IStaffSessionSignIn
CookieStaffSessionSignIn ..> DatabaseTicketStore : session kept on the server
Member "1" --> "0..1" StaffRole
Member "1" --> "0..1" StaffTwoStep
StaffRole --> StaffRoleName
@enduml
