@startuml
title UML sequence behaviour — Staff two-step verification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "TwoStepPage" as page
  participant "HttpStaffSessionService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "StaffSessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "VerifyTwoStepHandler" as handler
  participant "StaffTwoStep / Totp" as totp
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "CookieTwoStepCookie" as step
  participant "CookieStaffSessionSignIn" as cookie
  database "Christian Fitness database" as db
end box
actor -> page : Enter the authenticator's code, Verify
page -> client : verify(code)
client -> ctrl : POST /api/admin/session/two-step (X-XSRF-TOKEN, __Host-cf-admin-step)
ctrl -> handler : Send VerifyTwoStepCommand
handler -> step : Read()
handler -> db : Find TwoStepChallenge by token hash
alt no cookie, no challenge or older than 5 minutes (L2-046 AC5)
  handler -> step : Clear()
  ctrl --> client : 401 two_step_expired
  page --> actor : Staff sign in: "Sign in again"
else challenge open
  handler -> db : Count TwoStepFailures since now - 15 minutes
  alt 5 or more (AttemptWindow full, L2-046 AC4)
    handler -> db : End the challenge
    handler -> step : Clear()
    ctrl --> client : 429 too_many_attempts
    page --> actor : Staff sign in: "Too many codes tried"
  else room in the window
    handler -> totp : TryUse(code, now): step -1, 0 or +1, not used before
    alt wrong, malformed or reused (L2-046 AC3)
      handler -> db : Add TwoStepFailure
      ctrl --> client : 401 invalid_code
      page --> actor : Field error "That code doesn't match…", code kept
    else right (L2-046 AC2)
      handler -> db : Record the step used, end the challenge
      handler -> step : Clear()
      handler -> cookie : SignInAsync(member, role)
      cookie -> db : Store the session (Sessions)
      ctrl --> client : 200 StaffSessionDto, __Host-cf-admin cookie
      page --> actor : Navigate to the Dashboard
    end
  end
end
@enduml
