@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Admin sign-in

Container_Boundary(admin, "Admin web app") {
  Component(page, "SignInPage", "Angular page", "Staff sign in: Google button and its notices")
  Component(ui, "StaffLayout, GoogleButton, SsoNotice", "components library", "staff, google-button, sso-notice blocks")
  Component(svc, "HttpStaffSessionService", "STAFF_SESSION_SERVICE", "startGoogle, completeGoogle, current, signOut")
  Component(guard, "staffAuthGuard", "Route guard", "Opens the shell only with a staff session")
  Component(icpt, "sessionExpiredInterceptor, forbiddenInterceptor", "HTTP interceptors", "Session expired notice; Staff only screen")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "StaffSessionController", "ASP.NET Core controller", "POST google/start, POST google, GET, DELETE /api/admin/session")
  Component(policy, "Staff policy", "Authorization", "On every controller under api/admin")
  Component(start, "StartGoogleSignInHandler", "MediatR handler", "Limit, settings, GoogleStaff challenge")
  Component(oidc, "GoogleStaff scheme", "OpenID Connect handler", "hd = team's domain; ID token checks")
  Component(handler, "CompleteStaffGoogleSignInHandler", "MediatR handler", "Domain, match, staff role, session")
  Component(match, "GoogleAccountMatch", "Application service", "Subject, then email")
  Component(cookie, "Staff cookie scheme", "Cookie authentication", "__Host-cf-admin, Strict, 30 minutes idle, 12 hours at most")
}
ContainerDb(db, "Christian Fitness database", "EF Core, PostgreSQL", "Members, staff roles, sessions")
System_Ext(google, "Google Workspace", "OpenID Connect provider")

Rel(page, ui, "Renders")
Rel(page, svc, "startGoogle, completeGoogle")
Rel(guard, svc, "Calls current")
Rel(svc, icpt, "Requests pass through")
Rel(icpt, ctrl, "Calls", "JSON/HTTPS")
Rel(policy, ctrl, "Guards GET and DELETE")
Rel(ctrl, start, "Sends StartGoogleSignInCommand")
Rel(start, oidc, "Challenges")
Rel(oidc, google, "Exchanges code; reads keys", "HTTPS")
Rel(ctrl, handler, "Sends CompleteStaffGoogleSignInCommand")
Rel(handler, match, "Finds the member")
Rel(handler, cookie, "Signs in through IStaffSessionSignIn")
Rel(match, db, "Reads Member and StaffRole", "EF Core")
Rel(cookie, db, "Keeps the session", "EF Core")
@enduml
