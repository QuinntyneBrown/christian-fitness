@startuml
title UML sequence behaviour — Staff sign-in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "SignInPage" as page
  participant "HttpStaffSessionService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "StaffSessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "StaffSignInHandler" as handler
  participant "MemberCredentials" as creds
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "CookieStaffSessionSignIn" as cookie
  database "Christian Fitness database" as db
end box
actor -> page : Enter work email and password, Sign in
page -> client : signIn(email, password)
client -> ctrl : POST /api/admin/session (X-XSRF-TOKEN)
ctrl -> handler : Send StaffSignInCommand
handler -> creds : VerifyAsync(email, password)
creds -> db : Load Member by normalised email
creds -> creds : PBKDF2 check (a fixed hash for an unknown email)
alt unknown email or wrong password (L2-018 AC3)
  creds --> ctrl : invalid_credentials
  ctrl --> client : 401 ProblemDetails
  page --> actor : "Email or password is incorrect"
else credentials right
  handler -> db : Read StaffRole
  alt no StaffRole (L2-018 AC2)
    handler --> ctrl : not_staff
    ctrl --> client : 403 ProblemDetails code not_staff, no cookie
    page --> actor : "This account isn't on the team"
  else staff (L2-018 AC1)
    handler -> cookie : SignInAsync(member, role)
    cookie -> db : Store the session (Sessions)
    handler --> ctrl : StaffSessionDto
    ctrl --> client : 200 StaffSessionDto, __Host-cf-admin cookie
    client --> page : Session
    page --> actor : Navigate to the Dashboard
  end
end
@enduml
