@startuml
title UML sequence behaviour — Staff sign in with Google
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "SignInPage" as page
  participant "HttpStaffSessionService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "StaffSessionController" as ctrl
  participant "GoogleStaff scheme" as oidc
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "StartGoogleSignInHandler" as start
  participant "CompleteStaffGoogleSignInHandler" as h
  participant "GoogleAccountMatch" as match
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "CookieStaffSessionSignIn" as sess
  database "Christian Fitness database" as db
end box
participant "Google Workspace" as google
actor -> page : Press "Sign in with Google"
page --> actor : "Opening Google…", disabled (L2-018 AC1)
page -> client : startGoogle()
client -> ctrl : POST /api/admin/session/google/start
ctrl -> start : Send StartGoogleSignInCommand(App = Staff)
start --> ctrl : Address with hd = team's domain, or a refusal (L2-018 AC10, L2-049 AC7)
ctrl --> client : 200 { location }
page -> google : Full-page redirect
actor -> google : Choose a Workspace account; Google checks password and two-step
google -> oidc : GET /api/admin/session/google/callback?code&state
oidc -> google : Exchange code; validate ID token (L2-049 AC2)
oidc --> actor : 302 /sign-in?google=returned, __Host-cf-google set
actor -> page : Open
page -> client : completeGoogle()
client -> ctrl : POST /api/admin/session/google
ctrl -> h : Send CompleteStaffGoogleSignInCommand
h -> h : Read GoogleIdentity
alt Google answer failed or email unverified
  h --> ctrl : refused, 401
  ctrl --> client : ProblemDetails
  page --> actor : "Google sign-in didn't finish" (L2-018 AC8)
else hd is not the team's domain (L2-018 AC3)
  h --> ctrl : RefusalException wrong_domain with account
  ctrl --> client : 403 ProblemDetails code wrong_domain, no session
  page --> actor : "That's not a staff account", account named, focused;\nbutton "Try another Google account"
else Team's domain
  h -> match : FindAsync(identity)
  match -> db : Member by GoogleSubject, then NormalizedEmail; link
  match --> h : Member or none
  h -> db : Read StaffRole
  alt No member or no staff role (L2-018 AC4)
    h --> ctrl : RefusalException not_staff with account
    ctrl --> client : 403 ProblemDetails code not_staff, no session
    page --> actor : "No admin access yet", account named, focused
  else Staff role
    h -> sess : SignInAsync(member, role)
    sess -> db : Store the ticket (IssuedUtc now)
    sess --> h : __Host-cf-admin
    h -> db : Audit staff_session.started; forget the Google identity
    h --> ctrl : StaffSessionDto
    ctrl --> client : 200 StaffSessionDto + Set-Cookie
    page --> actor : Dashboard (L2-018 AC2)
  end
end
@enduml
