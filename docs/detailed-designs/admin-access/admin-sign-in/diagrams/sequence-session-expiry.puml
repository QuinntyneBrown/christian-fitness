@startuml
title UML sequence behaviour — Idle staff session expires
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "staffAuthGuard (canActivateChild)" as guard
  participant "sessionExpiredInterceptor" as icpt
  participant "SignInPage" as signin
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "Staff cookie scheme and Staff policy" as auth
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "Any staff handler" as handler
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "DatabaseTicketStore" as store
  database "Christian Fitness database" as db
end box
actor -> guard : Open another area (or any screen's request)
guard -> icpt : GET /api/admin/session
icpt -> auth : Request with __Host-cf-admin cookie
auth -> store : RetrieveAsync(session key)
store -> db : Find the Sessions row
alt last request 30 minutes ago or more (L2-018 AC5)
  store -> db : Delete the expired row (the session ends on the server)
  store --> auth : no ticket
  auth --> icpt : 401 ProblemDetails code session_expired, cookie expired, no data (L2-018 AC4)
  note right of handler : Handler is never reached
  icpt -> signin : Navigate to /sign-in with state { session: 'expired' }
  signin --> actor : "Your session expired", sign in again
else within 30 minutes of the last request
  store --> auth : ticket
  auth -> handler : Send the request's MediatR request
  handler --> auth : answer
  auth -> store : RenewAsync: expires 30 minutes from now
  store -> db : Update the row's ExpiresAt
  auth --> icpt : 200 with the cookie sent again
  icpt --> guard : session
  guard --> actor : The area opens
end
@enduml
