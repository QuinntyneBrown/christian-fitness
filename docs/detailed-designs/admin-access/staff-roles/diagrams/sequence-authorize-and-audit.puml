@startuml
title UML sequence behaviour — Role check and audit
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "AdminEventsPage" as page
  participant "HttpAdminEventsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminOnly policy" as pol
  participant "AdminEventsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "AuditBehavior" as audit
  participant "UpdateEventHandler" as handler
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Save an event change
page -> client : updateEvent(...)
client -> pol : PUT /api/admin/events/{id}
pol -> db : Read StaffRole (claims transformation)
db --> pol : Role
alt role Moderator (L2-019 AC1)
  pol --> client : 403 ProblemDetails
  client --> page : Refusal with code
  page --> actor : Show forbidden message
else role Admin (L2-019 AC2)
  pol -> ctrl : Authorized
  ctrl -> audit : Send UpdateEventCommand
  audit -> handler : next()
  handler -> db : Load and change Event
  handler --> audit : Success
  audit -> db : Add AuditEntry(actor, action, record, time) (L2-019 AC3)
  audit -> db : SaveChanges in one unit of work
  db --> audit : Committed
  audit --> ctrl : Result
  ctrl --> client : 200
  client --> page : Updated event
  page --> actor : Success toast
end
@enduml
