@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Staff roles

class Member {
  +Guid Id
}
class StaffRole {
  +Guid MemberId
  +StaffRoleName Name
}
enum StaffRoleName {
  Admin
  Moderator
}
interface IAuditableCommand {
  +string AuditAction
}
class AuditTrail <<scoped>> {
  +Record(actorMemberId: Guid, recordType: string, recordId: Guid)
}
class "AuditBehavior<TRequest,TResponse>" as AuditBehavior {
  +Handle(req, next, ct): Task<TResponse>
}
class AuditEntry {
  +Guid Id
  +Guid ActorMemberId
  +string Action
  +string RecordType
  +Guid RecordId
  +DateTimeOffset OccurredAt
}
enum StaffArea {
  Console
  Dashboard
  Members
  Events
  Services
  Stories <<later slice>>
  Newsletter <<later slice>>
  Series <<later slice>>
  CommunityPick <<later slice>>
  Listings <<later slice>>
  Feedback <<later slice>>
  Unlisted
}
class StaffAccess <<static>> {
  +Allows(role: StaffRoleName, area: StaffArea): bool
}
class StaffAreaRequirement {
  +StaffArea Area
}
class StaffAreaAuthorizationHandler {
  #HandleRequirementAsync(context, requirement): Task
}
interface IAppDbContext

Member "1" --> "0..1" StaffRole
StaffRole --> StaffRoleName
AuditBehavior ..> IAuditableCommand : audits
AuditBehavior ..> AuditTrail : opens, then checks
AuditBehavior ..> IAppDbContext : saves
AuditTrail ..> AuditEntry : creates
AuditTrail ..> IAppDbContext : adds entry
StaffAreaAuthorizationHandler ..> StaffAreaRequirement : handles
StaffAreaAuthorizationHandler ..> StaffRole : reads every request
StaffAreaAuthorizationHandler ..> StaffAccess : asks
StaffAccess ..> StaffArea
StaffAccess ..> StaffRoleName
AuditEntry ..> Member : actor id, no foreign key
@enduml
