@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Staff roles

Person(staff, "Staff member", "Admin or Moderator")
System_Boundary(cf, "Christian Fitness") {
  Container(admin, "Admin web app", "Angular (standalone, signals, zoneless), projects/admin", "Staff console")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers, StaffOnly policy, ProblemDetails with code")
  Container(cli, "Christian Fitness CLI", ".NET console", "Migrations and idempotent seed")
  ContainerDb(db, "Christian Fitness database", "EF Core, engine <TO SUPPLY>", "Members, staff roles, events, audit entries")
}
System_Ext(otel, "OpenTelemetry collector", "Telemetry sink")

Rel(staff, admin, "Uses", "HTTPS")
Rel(admin, api, "Calls", "JSON/HTTPS, session cookie")
Rel(api, db, "Reads and writes", "EF Core")
Rel(cli, db, "Migrates and seeds", "EF Core")
Rel(api, otel, "Exports telemetry", "OTLP")
@enduml
