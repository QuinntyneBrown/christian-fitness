@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Staff roles

Container_Boundary(admin, "Admin web app") {
  Component(nav, "AdminShell", "Angular layout", "Hides areas by role")
  Component(canm, "canManage", "domain helper", "Role to area rule")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(conv, "StaffAreaConvention", "MVC convention", "Area policy per api/admin controller")
  Component(pol, "Staff area policies", "Authorization policies", "Staff, Staff:Events, ...")
  Component(claims, "StaffAreaAuthorizationHandler", "Infrastructure", "Reads the role every request")
  Component(rule, "StaffAccess.Allows", "Domain rule", "Role to area table")
  Component(result, "StaffRefusalResultHandler", "Api", "403 with not_staff or forbidden_role")
  Component(ctrl, "Staff controllers", "ASP.NET Core", "One MediatR send each")
  Component(audit, "AuditBehavior", "MediatR pipeline behaviour", "Writes AuditEntry")
  Component(handler, "Auditable handlers", "MediatR handlers", "Change data")
}
ContainerDb(db, "Christian Fitness database", "EF Core, PostgreSQL", "Persistent state")

Rel(nav, canm, "Uses")
Rel(nav, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, pol, "Protected by")
Rel(conv, ctrl, "Gives each its area policy")
Rel(pol, claims, "Evaluated by")
Rel(claims, rule, "Asks")
Rel(pol, result, "Refusal written by")
Rel(ctrl, audit, "Sends command through")
Rel(audit, handler, "Invokes")
Rel(audit, db, "Adds AuditEntry", "EF Core")
Rel(claims, db, "Reads StaffRole", "EF Core")
@enduml
