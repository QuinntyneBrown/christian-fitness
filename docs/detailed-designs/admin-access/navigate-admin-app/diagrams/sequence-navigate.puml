@startuml
title UML sequence behaviour — Navigate the admin app
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "AdminShell" as shell
  participant "AdminNav" as nav
  participant "Angular Router" as router
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "StaffSessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetStaffSessionHandler" as handler
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
shell -> ctrl : GET /api/admin/session (once per shell)
ctrl -> handler : Send GetStaffSessionQuery
handler -> db : Read StaffRole and name
handler --> ctrl : StaffSessionDto
ctrl --> shell : Name, role and initials in the sidebar
shell -> shell : items = areasFor(role) with groups (L2-019 AC5)
alt Admin at LG or wider (L2-021 AC1)
  shell -> nav : items, showGroups = true
  nav --> actor : Dashboard; Publish, Gather, Community headings
else Moderator, or viewport below LG (L2-021 AC1, AC2)
  shell -> nav : items, showGroups = false
  nav --> actor : Links without group names;\nbelow LG one row scrolling within the band
end
note over nav : At LG, links taller than the window scroll inside\nAdminNav; brand and Sign out stay in view (L2-021 AC4)
actor -> nav : Click or press Enter on Stories
nav -> nav : Plain click: prevent the page load
nav --> shell : navigate('/stories')
shell -> router : navigateByUrl('/stories')
router -> ctrl : staffAuthGuard (canActivateChild): GET /api/admin/session
ctrl --> router : session (an expired one opens Staff sign in, ADR 0016)
router -> router : loadComponent for the area
router --> shell : NavigationEnd
shell -> shell : current = currentAdminArea(url)\n(/stories/<id> stays Stories)
shell -> nav : current = stories
nav --> actor : aria-current="page" on Stories (L2-021 AC1)
@enduml
