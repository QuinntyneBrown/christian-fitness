@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Navigate the admin app

Container_Boundary(admin, "Admin web app") {
  Component(shell, "AdminShell", "Angular layout route", "Hosts the staff routes")
  Component(layout, "AdminLayout", "components", "admin block: sidebar or band, main")
  Component(nav, "AdminNav", "components", "admin-nav block, aria-current")
  Component(user, "AdminUser", "components", "Staff member and Sign out")
  Component(area, "AreaPage", "Angular page", "Stand-in heading per area")
  Component(svc, "HttpStaffSessionService", "STAFF_SESSION_SERVICE", "Session and sign-out")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "StaffSessionController", "ASP.NET Core controller", "GET, DELETE /api/admin/session")
}
ContainerDb(db, "Christian Fitness database", "EF Core, PostgreSQL", "Persistent state")

Rel(shell, layout, "Renders")
Rel(layout, nav, "Renders")
Rel(layout, user, "Renders")
Rel(shell, area, "Routes to")
Rel(shell, svc, "Reads session, signs out")
Rel(svc, ctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, db, "Reads staff role, ends the session", "EF Core")
@enduml
