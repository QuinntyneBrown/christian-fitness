@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Navigate the admin app

class AdminShell {
  -items: Signal<AdminNavItem[]>
  -current: WritableSignal<AdminAreaKey | null>
  -staff: WritableSignal<StaffSessionDto | null>
  -counts: WritableSignal<WaitingCounts>
  -signingOut: WritableSignal<boolean>
  +navigate(href: string): void
  +signOut(): void
}
class AdminLayout {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +showGroups: InputSignal<boolean>
  +navigate: OutputEmitterRef<string>
  +signOut: OutputEmitterRef<void>
}
class SidebarNavigation {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +showGroups: InputSignal<boolean>
  +userName, userRole, userInitials: InputSignal<string>
  +signingOut: InputSignal<boolean>
}
class AdminNav {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +showGroups: InputSignal<boolean>
  +navigate: OutputEmitterRef<string>
}
class AdminUser {
  +name, role, initials: InputSignal<string>
  +signOut: OutputEmitterRef<void>
}
class AdminNavItem {
  +key: string
  +label: string
  +href: string
  +group?: AdminNavGroup
  +count?: number
  +countLabel?: string
}
enum AdminNavGroup {
  Publish
  Gather
  Community
}
enum AdminAreaKey {
  dashboard
  stories
  newsletter
  events
  series
  community-pick
  listings
  services
  members
  feedback
}
class AdminArea {
  +key: AdminAreaKey
  +label: string
  +path: string
  +group?: AdminNavGroup
}
class "admin-areas (domain)" as areas <<module>> {
  +ADMIN_AREAS: AdminArea[]
  +currentAdminArea(url): AdminAreaKey | null
  +canManage(role, area): boolean
  +areasFor(role): AdminArea[]
}
class "waitingCountsFor(totals)" as counts <<function>> {
  stories -> "n story/stories to review"
  listings -> "n suggestion(s) to check"
  services -> "n application(s) waiting"
  members -> "n report(s) to review"
  feedback -> "n new note(s)"
}
class WorkAwaitingStaffDto {
  +Applications?: AwaitingListDto
  +FlaggedMembers: AwaitingListDto
  +Stories?: AwaitingListDto
  +Suggestions?: AwaitingListDto
  +Feedback?: AwaitingListDto
}
interface StaffSessionApi
interface AdminDashboardApi {
  +awaiting(): Observable<WorkAwaitingStaffDto>
}
AdminShell *-- AdminLayout
AdminLayout *-- SidebarNavigation
SidebarNavigation *-- AdminNav
SidebarNavigation *-- AdminUser
AdminNav --> "*" AdminNavItem
AdminNavItem --> AdminNavGroup
AdminArea --> AdminAreaKey
AdminArea --> AdminNavGroup
areas --> "10" AdminArea
AdminShell ..> areas
AdminShell ..> counts
counts ..> WorkAwaitingStaffDto : reads totals
AdminShell ..> StaffSessionApi : injects STAFF_SESSION_SERVICE
AdminShell ..> AdminDashboardApi : injects ADMIN_DASHBOARD_SERVICE
@enduml
