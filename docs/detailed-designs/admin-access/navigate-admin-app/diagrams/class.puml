@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Navigate the admin app

class AdminShell {
  -items: AdminNavItem[]
  -current: WritableSignal<AdminAreaKey | null>
  -staff: WritableSignal<StaffSessionDto | null>
  -signingOut: WritableSignal<boolean>
  +navigate(href: string): void
  +signOut(): void
}
class AdminLayout {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +navigate: OutputEmitterRef<string>
  +signOut: OutputEmitterRef<void>
}
class SkipLink {
  +target: InputSignal<string>
}
class SidebarNavigation {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +userName, userRole, userInitials: InputSignal<string>
  +signingOut: InputSignal<boolean>
  +navigate: OutputEmitterRef<string>
  +signOut: OutputEmitterRef<void>
}
class AdminNav {
  +items: InputSignal<AdminNavItem[]>
  +current: InputSignal<string | null>
  +navigate: OutputEmitterRef<string>
}
class AdminUser {
  +name, role, initials: InputSignal<string>
  +signOut: OutputEmitterRef<void>
}
class AreaPage {
  -heading: string
}
class AdminNavItem {
  +key: string
  +label: string
  +href: string
  +count?: number
  +countLabel?: string
}
class "ADMIN_AREAS, currentAdminArea(), initialsOf()" as domain
interface StaffSessionApi
AdminShell *-- AdminLayout
AdminLayout *-- SkipLink
AdminLayout *-- SidebarNavigation
SidebarNavigation *-- AdminNav
SidebarNavigation *-- AdminUser
AdminShell ..> AreaPage : router outlet
AdminShell ..> StaffSessionApi : injects STAFF_SESSION_SERVICE
AdminShell ..> domain
AdminNav --> AdminNavItem
@enduml
