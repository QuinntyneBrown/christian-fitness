@startuml
title UML sequence behaviour — follow and unfollow a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "DirectoryPage or ListingProfilePage" as page
  participant "ListingFollowStore" as store
  participant "DirectoryApi (DIRECTORY_SERVICE)" as client
  participant "ToastStore" as toast
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "FollowListingHandler / UnfollowListingHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Press Follow
page -> store : toggle(id, name)
store --> page : following = true, followers + 1 at once (L2-056 AC1, AC3)
page --> actor : "Follow" (fixed label), aria-pressed="true", fill and check mark
store -> client : follow(id)
client -> ctrl : PUT /api/directory/{id}/follow
ctrl -> h : Send FollowListingCommand
h -> db : Caller's status; listing Status == Published
alt member suspended
  h --> ctrl : 403 account_suspended (L2-056 AC5)
else listing not published
  h --> ctrl : 404 listing_not_found
else allowed
  h -> db : Insert (MemberId, ListingId) unless present (L2-056 AC4)
  db --> h : Saved, or already there
  h -> db : Count followers
  db --> h : Count
  h --> ctrl : ListingFollowDto(true, count)
end
ctrl --> client : 200 JSON or ProblemDetails
client --> store : Result
alt failure or refusal
  store --> page : following = false, count restored
  store -> toast : Danger: "We couldn't follow <name>", "Try again in a moment."
  page --> actor : Button back to "Follow"; toast role="alert" (L2-056 AC3)
else success
  store --> page : Server count shown
end
actor -> page : Press Follow (pressed)
page -> store : toggle(id, name)
store --> page : following = false, followers - 1 at once, no confirmation (L2-056 AC2)
store -> client : unfollow(id)
client -> ctrl : DELETE /api/directory/{id}/follow
ctrl -> h : Send UnfollowListingCommand
h -> db : Remove pair when present
db --> h : Done
h --> ctrl : ListingFollowDto(false, count)
ctrl --> client : 200 JSON
client --> store : Result; on failure restore and toast "We couldn't unfollow <name>"
@enduml
