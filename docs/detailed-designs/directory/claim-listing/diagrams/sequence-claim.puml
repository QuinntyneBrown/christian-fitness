@startuml
title UML sequence behaviour — claim a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Suggested party or sender" as party
box "Frontend — Member web app" #E0F2FE
  participant "ClaimSignInPage or ClaimListingPage" as page
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ListingClaimsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "Claim handlers" as h
  participant "ListingClaim" as claim
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
party -> page : Opens /claim/{token}
page -> ctrl : GET /api/claims/{token} (anonymous)
ctrl -> h : GetListingClaimQuery
h -> db : Find claim by hash of token
alt unknown
  h --> page : 404 claim_not_found
else used, or listing no longer a draft
  h --> page : 409 claim_link_used
else expired or voided
  h --> page : 410 claim_link_expired
else signed out
  h --> page : 200 name and expiry only
  page --> party : Sign in or Join, then back to the link
else signed in
  h --> page : 200 name, expiry and preview
end
party -> page : Publish my listing
page -> ctrl : POST /api/claims/{token}/publish
ctrl -> h : PublishListingClaimCommand
h -> claim : Spend(now)
h -> db : Listing Published, owner = member, link spent, audit listing.claimed
h --> page : 200
page --> party : Your listing is live
party -> page : This isn't me
page -> ctrl : POST /api/claims/{token}/decline
ctrl -> h : DeclineListingClaimCommand
h -> claim : Spend(now)
h -> db : Listing Declined, link spent, audit listing.claim_declined
h --> page : 200
page --> party : Thanks for letting us know
@enduml
