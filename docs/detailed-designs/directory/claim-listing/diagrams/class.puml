@startuml
title UML class structure — claim a listing
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
class ClaimSignInPage <<web>>
class ClaimListingPage <<web>>
interface ListingClaimsApi <<api>> {
  get(token): ListingClaimDto
  publish(token)
  decline(token)
}
class ListingClaim <<domain>> {
  TokenHash
  ExpiresAt
  UsedAt
  VoidedAt
  StateAt(now)
  Spend(now)
  Void(now)
}
class DirectoryListing <<domain>> {
  Status: Draft | Published | Declined
  MemberId?
  Claim(member, now)
  Decline()
}
class ClaimLinks <<application>>
ClaimSignInPage --> ListingClaimsApi
ClaimListingPage --> ListingClaimsApi
ListingClaim --> DirectoryListing
ClaimLinks ..> ListingClaim
@enduml
