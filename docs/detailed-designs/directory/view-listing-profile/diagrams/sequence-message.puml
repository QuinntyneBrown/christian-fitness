@startuml
title UML sequence behaviour — message a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ListingProfilePage" as page
  participant "DirectoryApi (DIRECTORY_SERVICE)" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "StartListingConversationHandler" as h
  participant "DirectChat" as chat
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Choose Message
page -> client : startConversation(id)
client -> ctrl : POST /api/directory/{id}/conversation
ctrl -> h : Send StartListingConversationCommand
h -> db : Published listing's owner
db --> h : Owner memberId or none
alt listing unknown or unpublished
  h --> ctrl : 404 listing_not_found
else no owner
  h --> ctrl : Refusal, code listing_unreachable
else owner found
  h -> chat : OtherNameAsync(caller, memberId)
  alt suspended or the caller's own listing
    chat --> h : null
    h --> ctrl : 403 recipient_unavailable
  else available
    chat --> h : Name
    h --> ctrl : ListingConversationDto(memberId)
  end
end
ctrl --> client : 200 JSON or ProblemDetails
client --> page : Result
alt success
  page --> actor : Navigate to /messages/<memberId> with listing context (L2-055 AC6)
  note over page, h
    The first send carries listing context; the server verifies
    the published listing and current owner before applying
    the messaging-preference exception (ADR 0061).
  end note
else refused
  page --> actor : Generic message; branch on code only
end
@enduml
