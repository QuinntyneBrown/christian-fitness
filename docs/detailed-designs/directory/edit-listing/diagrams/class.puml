@startuml
title UML class structure — edit my listing
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
class OwnerListingEditorDialog <<web>>
interface DirectoryApi <<api>> {
  updateOwn(id, update): { nameChangePending, listing }
  uploadPhoto(file): { photoKey }
}
class UpdateOwnListingHandler <<application>>
class DirectoryListing <<domain>> {
  MemberId?
  Kind, Name, Description, WebsiteUrl, PhotoKey, Focus, ContactEmail
  PendingName?, PendingKind?, PendingSince?
  Edit(description, website, focus, contact)
  AskToRename(name, kind, at)
  ApproveChange() / DeclineChange()
}
OwnerListingEditorDialog --> DirectoryApi
UpdateOwnListingHandler --> DirectoryListing
@enduml
