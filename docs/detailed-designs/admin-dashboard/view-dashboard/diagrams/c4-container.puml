@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the admin dashboard

Person(staff, "Staff member", "Admin or Moderator")
Person(member, "Member", "Generates activity and waiting work")
System_Boundary(cf, "Christian Fitness") {
  Container(admin, "Admin web app", "Angular (standalone, signals, zoneless), projects/admin", "Staff console")
  Container(web, "Member web app", "Angular, projects/web", "Member screens")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers, staff policies, ProblemDetails with code")
  Container(cli, "Christian Fitness CLI", ".NET console", "Migrations and idempotent seed")
  ContainerDb(db, "Christian Fitness database", "EF Core, PostgreSQL", "Members, events, messages, applications, stories, suggestions, feedback")
}
System_Ext(otel, "OpenTelemetry collector", "Telemetry sink")

Rel(staff, admin, "Opens the Dashboard in", "HTTPS")
Rel(admin, api, "GET activity and awaiting", "JSON/HTTPS, session cookie")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Counts and reads", "EF Core")
Rel(cli, db, "Migrates and seeds", "EF Core")
Rel(api, otel, "Exports telemetry", "OTLP")
@enduml
