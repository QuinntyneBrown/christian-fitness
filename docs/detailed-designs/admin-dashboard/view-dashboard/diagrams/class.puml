@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the admin dashboard

interface AdminDashboardApi {
  +activity(): Observable<CommunityActivityDto>
  +awaiting(): Observable<WorkAwaitingStaffDto>
}
class HttpAdminDashboardService
class AdminDashboardPage {
  -state: Signal<ActivityState>
  -attention: Signal<AttentionState>
  #tryAgain(): void
  #tryAgainAttention(): void
}
class "work-awaiting (domain)" as wa <<module>> {
  +awaitingRowsOf(a): AwaitingRow[]
  +awaitingTotalOf(a): number
  +awaitingMoreOf(a): AwaitingMore[]
  +seesApplications(a): boolean
}
class "community-activity (domain)" as ca <<module>> {
  +activityRowsOf(weeks): ActivityRow[]
  +hasActivity(weeks): boolean
}
class GetWorkAwaitingStaffQuery
class GetWorkAwaitingStaffHandler {
  +Shown: int = 3
  +Handle(q): Task<WorkAwaitingStaffDto>
}
class GetCommunityActivityQuery
class GetCommunityActivityHandler {
  +Handle(q): Task<CommunityActivityDto>
}
class WorkAwaitingStaffDto {
  +Stories?: AwaitingListDto<AwaitingStoryDto>
  +Suggestions?: AwaitingListDto<AwaitingSuggestionDto>
  +Feedback?: AwaitingCountDto
  +Applications?: AwaitingListDto<AwaitingApplicationDto>
  +FlaggedMembers: AwaitingListDto<AwaitingFlaggedMemberDto>
}
class "AwaitingListDto<T>" as list {
  +int Total
  +IReadOnlyList<T> Items
}
class AwaitingCountDto <<new>> {
  +int Total
}
class AwaitingStoryDto <<new>> {
  +Guid Id
  +string Title
  +string Writer
  +DateTimeOffset SubmittedAt
}
class AwaitingSuggestionDto <<new>> {
  +Guid Id
  +string Name
}
class AwaitingApplicationDto {
  +Guid Id
  +string Name
  +string Role
  +DateTimeOffset SubmittedAt
}
class AwaitingFlaggedMemberDto {
  +Guid Id
  +string Name
  +string? Note
}
class CommunityActivityDto {
  +IReadOnlyList<CommunityActivityWeekDto> Weeks
}
interface IAppDbContext
class StaffRoles {
  +OfAsync(db, memberId): StaffRoleName?
}

HttpAdminDashboardService ..|> AdminDashboardApi
AdminDashboardPage ..> AdminDashboardApi : injects ADMIN_DASHBOARD_SERVICE
AdminDashboardPage ..> wa
AdminDashboardPage ..> ca
GetWorkAwaitingStaffHandler ..> GetWorkAwaitingStaffQuery : handles
GetCommunityActivityHandler ..> GetCommunityActivityQuery : handles
GetWorkAwaitingStaffHandler ..> StaffRoles
GetWorkAwaitingStaffHandler ..> IAppDbContext
GetCommunityActivityHandler ..> IAppDbContext
GetWorkAwaitingStaffHandler ..> WorkAwaitingStaffDto : returns
GetCommunityActivityHandler ..> CommunityActivityDto : returns
WorkAwaitingStaffDto *-- list
WorkAwaitingStaffDto *-- AwaitingCountDto
list o-- AwaitingStoryDto
list o-- AwaitingSuggestionDto
list o-- AwaitingApplicationDto
list o-- AwaitingFlaggedMemberDto
@enduml
