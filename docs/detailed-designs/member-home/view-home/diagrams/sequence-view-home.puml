@startuml
title UML sequence behaviour — Member opens Home
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "MemberShell / MemberInbox" as shell
  participant "HomePage" as page
  participant "HttpHomeService" as homeClient
  participant "HttpConversationsService" as convClient
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "HomeController" as homeCtrl
  participant "ConversationsController" as convCtrl
end box
box "Backend — Christian Fitness Application" #ECFDF3
  participant "GetHomeHandler" as homeH
  participant "ListConversationsHandler" as convH
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> shell : Open /home
shell -> convClient : list()
convClient -> convCtrl : GET /api/conversations
page -> homeClient : home()
homeClient -> homeCtrl : GET /api/home
homeCtrl -> homeH : Send GetHomeQuery
homeH -> db : Next registered event, up to 3 suggested events, unreadCount
db --> homeH : Rows + unread total
homeH --> homeCtrl : HomeDto (nextEvent, suggested, unreadCount)
homeCtrl --> homeClient : 200 JSON
alt Conversations succeed (L2-007 AC4, L2-008 AC3)
  convCtrl -> convH : Send ListConversationsQuery
  convH -> db : Group and direct conversations + unread counts
  db --> convH : ConversationListDto
  convH --> convCtrl : 200 JSON
  convCtrl --> convClient : Conversations
  convClient --> shell : Unread badge on TopBar + TabBar; top 3 rows on HomePage
  page --> actor : Greeting, next event (or invite), suggestions, and Messages aside (or empty invite)
else Conversations fail while Home succeeded (L2-007 AC5)
  convClient --> shell : Error
  page --> actor : Events shown; Messages aside shows "Messages didn't load." + Try again
  actor -> page : Try again
  page -> shell : retry() reloads GET /api/conversations in place
end
@enduml
