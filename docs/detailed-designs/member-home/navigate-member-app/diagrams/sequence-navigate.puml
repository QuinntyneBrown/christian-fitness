@startuml
title UML sequence behaviour — Member navigates between screens
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "MemberShell" as shell
  participant "TopBar / TabBar" as nav
  participant "UnreadCountService" as svc
  participant "SignalRChatConnection" as conn
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "MessagesController" as ctrl
  participant "ChatHub" as hub
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetUnreadCountHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> shell : Open a member route
shell -> svc : Read unread count
svc -> ctrl : GET unread count
ctrl -> h : Send GetUnreadCountQuery
h -> db : Count unread for caller
db --> h : Count
h --> ctrl : number
ctrl --> svc : 200 JSON
svc -> conn : Subscribe to message events
conn -> hub : Connect (shared via parent route)
shell -> nav : destinations, current, unreadCount
alt Viewport MD or wider (L2-008 AC1)
  nav --> actor : Header with aria-current="page" on current
else Viewport XS or SM (L2-008 AC2)
  nav --> actor : Bottom bar, targets >= 44 x 44 px
end
nav --> actor : Messages shows count as text (L2-008 AC3)
hub --> conn : Message event
conn --> svc : Update count signal
svc --> shell : New count
actor -> nav : Choose a destination
nav -> shell : Navigate; current updates
@enduml
