@startuml
title UML sequence behaviour — Member navigates between screens
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "MemberShell" as shell
  participant "TopBar / TabBar" as nav
  participant "MemberInbox" as inbox
  participant "HttpConversationsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ConversationsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ListConversationsHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> shell : Open a member route
shell -> inbox : refresh()
inbox -> client : list()
client -> ctrl : GET /api/conversations
ctrl -> h : Send ListConversationsQuery
h -> db : Read caller's conversations
db --> h : Conversations with unread counts
h --> ctrl : ConversationListDto
ctrl --> client : 200 JSON
client --> inbox : Conversations
inbox --> shell : unread = totalUnreadOf(...)
shell -> shell : current = placeOf(url)\n(/directory/<id> -> Directory,\n/events/series/<id> -> Events)
shell -> nav : six destinations, current, unread
alt Viewport MD or wider (L2-008 AC1)
  nav --> actor : Header: Home, Events, Directory, Services, Messages;\naria-current="page" on current
else Viewport XS or SM (L2-008 AC2)
  nav --> actor : Bottom bar of six tabs, >= 44 x 44 px,\nno label cut at 360 px
end
nav --> actor : Messages shows count as text (L2-008 AC3)
actor -> nav : Choose Directory
nav -> shell : navigate('/directory')
shell -> shell : current = directory; inbox.refresh()
@enduml
