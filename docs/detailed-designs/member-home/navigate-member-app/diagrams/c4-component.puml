@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Navigate the member app

Container_Boundary(web, "Member web app") {
  Component(shell, "MemberShell", "Angular layout route", "Router outlet, DESTINATIONS, placeOf, footer placement")
  Component(skip, "SkipLink", "components library", "Skip to content")
  Component(nav, "TopBar", "components library", "app-header with app-nav (six destinations) and Sign out")
  Component(tab, "TabBar", "components library", "Bottom bar, six tabs")
  Component(foot, "Footer (app variant)", "components library", "app-footer: Send feedback, Preferences, Privacy, Terms")
  Component(badge, "CountBadge", "components library", "Unread count as text")
  Component(inbox, "MemberInbox", "Shell-scoped service", "Conversations and unread signal")
  Component(svc, "HttpConversationsService", "CONVERSATIONS", "HTTP client")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "ConversationsController", "ASP.NET Core controller", "GET /api/conversations")
  Component(h, "ListConversationsHandler", "MediatR handler", "Caller's conversations with unread counts")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Persistent store")

Rel(shell, skip, "Renders first")
Rel(shell, nav, "Renders; links at MD+")
Rel(shell, tab, "Renders at XS/SM")
Rel(shell, foot, "Renders unless route fills the window")
Rel(nav, badge, "Uses")
Rel(tab, badge, "Uses")
Rel(shell, inbox, "Reads unread; refreshes on navigation")
Rel(inbox, svc, "list()")
Rel(svc, ctrl, "GET /api/conversations", "JSON/HTTPS")
Rel(ctrl, h, "Sends ListConversationsQuery")
Rel(h, db, "Reads", "IAppDbContext")
@enduml
