@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Navigate the member app

Container_Boundary(web, "Member web app") {
  Component(shell, "MemberShell", "Angular layout route", "Router outlet and navigation")
  Component(skip, "SkipLink", "components library", "Skip to content")
  Component(nav, "TopBar", "components library", "app-header with app-nav and Sign out")
  Component(tab, "TabBar", "components library", "Bottom bar")
  Component(badge, "CountBadge", "components library", "Unread count as text")
  Component(svc, "UnreadCountService", "UNREAD_COUNT_SERVICE", "Unread count signal")
  Component(conn, "SignalRChatConnection", "CHAT_CONNECTION", "Realtime client")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "MessagesController", "ASP.NET Core controller", "Unread count endpoint <TO SUPPLY>")
  Component(hub, "ChatHub", "SignalR hub", "Pushes message events")
  Component(h, "GetUnreadCountHandler", "MediatR handler", "Counts unread")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Persistent store")

Rel(shell, skip, "Renders first")
Rel(shell, nav, "Renders; links at MD+")
Rel(shell, tab, "Renders at XS/SM")
Rel(nav, badge, "Uses")
Rel(tab, badge, "Uses")
Rel(shell, svc, "Reads unread count")
Rel(svc, ctrl, "GET unread count", "JSON/HTTPS")
Rel(svc, conn, "Subscribes")
Rel(conn, hub, "Connects", "WebSocket")
Rel(ctrl, h, "Sends GetUnreadCountQuery")
Rel(h, db, "Reads", "EF Core")
@enduml
