@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Navigate the member app
class MemberShell {
  #destinations: MemberDestination[]
  #current: Signal<MemberDestinationKey | null>
  #showFooter: Signal<boolean>
  #signingOut: Signal<boolean>
  #navigate(href: string): void
  #signOut(): void
}
class "placeOf(url)" as placeOf <<function>> {
  /directory, /directory/:id -> directory
  /events, /events/... -> events
  /profile, /preferences -> profile
  /feedback -> null
}
class SkipLink {
  +target: input<string>
}
class TopBar {
  +variant: input<'app'|'site'>
  +destinations: input<MemberDestination[]>
  +current: input<MemberDestinationKey | null>
  +unread: input<number>
  +profileHref, profileInitials: input<string>
  +signingOut: input<boolean>
  +navigate: output<string>
  +signOut: output<void>
}
class TabBar {
  +destinations: input<MemberDestination[]>
  +current: input<MemberDestinationKey | null>
  +unread: input<number>
  +navigate: output<string>
}
class Footer {
  +variant: input<'site'|'app'>
  +year: input<number>
  +feedbackHref: input<string>
  +navigate: output<string>
}
class CountBadge {
  +count: input<number>
}
class MemberDestination {
  +key: MemberDestinationKey
  +label: string
  +href: string
}
enum MemberDestinationKey {
  home
  events
  directory
  services
  messages
  profile
}
class MemberInbox {
  +state: Signal<'loading'|'loaded'|'failed'>
  +conversations: Signal<ConversationSummaryDto[]>
  +unread: Signal<number>
  +refresh(): void
}
interface ConversationsApi {
  +list(): Observable<ConversationSummaryDto[]>
}
interface SessionApi {
  +signOut(): Observable<void>
}
MemberShell ..> placeOf : current destination
MemberShell --> SkipLink
MemberShell --> TopBar
MemberShell --> TabBar
MemberShell --> Footer : app variant
TopBar --> CountBadge
TabBar --> CountBadge
TopBar --> "6" MemberDestination
TabBar --> "6" MemberDestination
MemberDestination --> MemberDestinationKey
MemberShell *-- MemberInbox : providers
MemberInbox ..> ConversationsApi : injects CONVERSATIONS
MemberShell ..> SessionApi : injects SESSION_SERVICE
@enduml
