@startuml
title UML sequence behaviour — Create a draft event
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "AdminEventsPage" as page
  participant "EventEditorDialog" as dlg
  participant "HttpAdminEventsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminEventsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "CreateEventValidator" as val
  participant "CreateEventHandler" as handler
  participant "Event" as entity
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : New event
page -> dlg : import() on first use, Dialog.open
actor -> dlg : Fill fields, Save draft
dlg -> dlg : Saving…, fields read-only
dlg -> client : create(eventDraftOf(values))
client -> ctrl : POST /api/admin/events
ctrl -> ctrl : Staff policy (ADR 0011)
ctrl -> val : Validate CreateEventCommand
alt invalid field (L2-022 AC2)
  val --> ctrl : Failures with field codes
  ctrl --> client : 400 validation_failed, fieldCodes
  client --> dlg : ApiError
  dlg --> actor : Generic alert, fields editable again, nothing saved (field marks: slice 10.2)
else valid
  val -> handler : Continue
  handler -> entity : CreateDraft(fields) (L2-022 AC1)
  entity --> handler : Event with Status Draft
  handler -> db : Add Event, SaveChanges
  db --> handler : Committed
  handler --> ctrl : AdminEventDto
  ctrl --> client : 201 AdminEventDto
  client --> dlg : Created
  dlg --> page : close(event) by its ref
  page --> actor : Draft saved toast, list loaded again with the draft
end
@enduml
