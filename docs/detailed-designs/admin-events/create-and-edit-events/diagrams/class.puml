@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Create and edit events

interface AdminEventsApi {
  +list(status: AdminEventTab): Observable<AdminEventListDto>
  +create(request: CreateEventRequestDto): Observable<AdminEventDto>
  +update(id: string, request): Observable<AdminEventDto> (10.2)
  +uploadImage(file: File): Observable<ImageResult> (10.2)
}
class AdminEventsPage {
  -state: Signal<loading | loaded | failed>
  -toast: Signal<ToastView | null>
  +newEvent(): Promise<void>
}
class HttpAdminEventsService
class EventEditorDialog {
  -values: Signal<EventEditorValues>
  -saving: Signal<boolean>
  +save(): void
}
class CreateEventCommand {
  +string Title
  +string Category
  +string Date
  +string StartTime
  +string Place
  +string Area
  +int? PriceCents
  +int? Capacity
  +string Summary
}
class ListAdminEventsQuery {
  +string? Status
}
class ListAdminEventsHandler
class AdminEventDto
class EventSchedule {
  +{static} TimeZoneInfo Toronto
  +{static} DateTimeOffset StartOf(DateOnly, TimeOnly)
}
class UpdateEventCommand {
  +Guid EventId
  +EventFields Fields
}
class CreateEventValidator
class CreateEventHandler
class UpdateEventHandler {
  +Handle(cmd): Task<Result<EventDto>>
}
class UploadEventImageCommand {
  +Stream Content
  +long Length
}
interface IImageStore {
  +SaveAsync(content: Stream): Task<string>
}
interface IAuditableCommand
class Registration {
  +Guid EventId
  +Guid MemberId
  +DateTimeOffset RegisteredAt
}
class Event {
  +Guid Id
  +string Title
  +EventCategory Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +int PriceCents
  +int Capacity
  +string? ImageKey
  +string Summary
  +EventStatus Status
  +Guid? ConversationId
}
enum EventStatus {
  Draft
  Published
  Cancelled (11.2)
}
enum EventCategory {
  Run
  Workout
  Basketball
  Mobility
  Workshop
  Retreat
}
Event --> EventStatus
Event --> EventCategory

HttpAdminEventsService ..|> AdminEventsApi
EventEditorDialog ..> AdminEventsApi : injects ADMIN_EVENTS_SERVICE
CreateEventValidator ..> CreateEventCommand
CreateEventValidator ..> EventSchedule : start after now
CreateEventHandler ..> Event : CreateDraft
CreateEventHandler ..> AdminEventDto
ListAdminEventsHandler ..> ListAdminEventsQuery
ListAdminEventsHandler ..> AdminEventDto
AdminEventsPage ..> AdminEventsApi : injects ADMIN_EVENTS_SERVICE
AdminEventsPage ..> EventEditorDialog : opens
UpdateEventHandler ..> Event : Edit
UpdateEventHandler ..> Registration : counts going
CreateEventCommand ..|> IAuditableCommand : slice 29.2
UpdateEventCommand ..|> IAuditableCommand : slice 29.2
UploadEventImageCommand ..> IImageStore
Event "1" --> "*" Registration
@enduml
