@startuml
title UML sequence behaviour — Export registrations as CSV
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "EventRegistrationsPage" as page
  participant "HttpAdminEventsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminEventsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ExportEventRegistrationsHandler" as handler
  participant "RegistrationsCsvWriter" as csv
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Export CSV
page -> client : exportRegistrations(id)
client -> ctrl : GET /api/admin/events/{id}/registrations.csv
ctrl -> handler : Send ExportEventRegistrationsQuery
handler -> db : Select MemberName, RegisteredAt only
db --> handler : Rows
handler -> csv : Write(rows)
csv --> handler : Name,Registered rows, formula-safe (L2-024 AC2)
handler --> ctrl : File bytes
ctrl --> client : 200 text/csv attachment
client --> page : Blob
page -> page : Download through object URL, then revoke
page --> actor : CSV saved
@enduml
