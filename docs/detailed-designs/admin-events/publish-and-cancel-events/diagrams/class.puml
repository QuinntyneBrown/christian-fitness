@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Publish and cancel events

class Event {
  +Guid Id
  +string Title
  +EventCategory Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +decimal? Price
  +int Capacity
  +string? ImageKey
  +string Summary
  +EventStatus Status
  +Guid? ConversationId
}
enum EventStatus {
  Draft
  Published
  Cancelled
}
enum EventCategory {
  Run
  Workout
  Basketball
  Mobility
  Workshop
  Retreat
}
Event --> EventStatus
Event --> EventCategory
class "Event (behaviour)" as EventB {
  +Publish(): Result
  +Cancel(now: DateTimeOffset): Result
}
class Conversation {
  +Guid Id
  +Guid? EventId
}
class Message {
  +Guid Id
  +Guid ConversationId
  +bool IsSystem
  +DateTimeOffset SentAt
}
class PublishEventCommand {
  +Guid EventId
}
class CancelEventCommand {
  +Guid EventId
}
class PublishEventHandler
class CancelEventHandler
interface IChatNotifier {
  +SendToConversationAsync(id: Guid, msg: MessageDto): Task
}
class SignalRChatNotifier

Event .. EventB
Event "1" --> "0..1" Conversation
Conversation "1" *-- "*" Message
PublishEventHandler ..> PublishEventCommand : handles
CancelEventHandler ..> CancelEventCommand : handles
PublishEventHandler ..> Event
CancelEventHandler ..> Event
CancelEventHandler ..> Message : adds notice
CancelEventHandler ..> IChatNotifier
SignalRChatNotifier ..|> IChatNotifier
@enduml
