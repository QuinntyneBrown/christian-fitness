@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Meet WCAG
left to right direction

class Button <<components>> {
  +variant: ButtonVariant
  +size: ButtonSize
  +disabled: InputSignal<boolean>
  +busy: InputSignal<boolean>
  aria-busy, presses ignored while busy
}
class FormField <<components>> {
  +fieldId: InputSignal<string>
  +label: InputSignal<string>
  +hint / error: InputSignal<string>
  +group: InputSignal<boolean>
  label for, fieldset + legend
}
class TextField <<components>> {
  aria-invalid, aria-describedby
  +valueChange: OutputEmitterRef<string>
}
class Textarea <<components>> {
  +maxLength: InputSignal<number>
  counter announced after a pause
}
class RadioGroup <<components>> {
  +value: InputSignal<string>
  +valueChange: OutputEmitterRef<string>
}
class Interest <<components>> {
  +pressed: InputSignal<boolean>
  aria-pressed
}
class Tooltip <<components>> {
  +tooltipId: InputSignal<string>
  role tooltip, Escape hides
}
class SkipLink <<components>> {
  +target: InputSignal<string>
  focuses main without a reload
}
class "fieldDescribedBy()" as Described <<components>>
TextField *-- FormField
Textarea *-- FormField
RadioGroup *-- FormField
TextField ..> Described
Button ..> Tokens
FormField ..> Tokens
Interest ..> Tokens
Tooltip ..> Tokens
SkipLink ..> Tokens
class MiniRow <<components>> {
  +unread: InputSignal<number>
  +current: InputSignal<boolean>
  "N unread" as text
}
class StatusChipComponent <<components>> {
  +status: InputSignal<MemberStatus>
  label text + icon
}
class Alert <<components>> {
  +tone: InputSignal<'danger' | 'info' | 'success'>
  +items: InputSignal<AlertItem[]>
  role alert or status; takes focus
}
class ToastRegion <<components>> {
  +toasts: InputSignal<ToastData[]>
  +paused: OutputEmitterRef<boolean>
  one status region; alert per danger toast
}
class Menu <<components>> {
  +sections: InputSignal<MenuSection[]>
  +selected: OutputEmitterRef<string>
  roving tabindex; Escape returns focus
}
class Dialog <<components>> {
  +titleId: InputSignal<string>
  +closed: OutputEmitterRef<void>
  shell inside a CDK Dialog
}
class Pagination <<components>> {
  +page: InputSignal<number>
  +navigate: OutputEmitterRef<number>
  aria-current="page"
}
class Tokens <<design system>> {
  --color-text-*
  --focus-ring
  --motion-duration-*
}
class Foundations <<global styles>> {
  :focus-visible
  @media prefers-reduced-motion
}
MiniRow ..> Tokens
StatusChipComponent ..> Tokens
Alert ..> Tokens
ToastRegion ..> Tokens
Menu ..> Tokens
Dialog ..> Tokens
Pagination ..> Tokens
Foundations ..> Tokens
@enduml
