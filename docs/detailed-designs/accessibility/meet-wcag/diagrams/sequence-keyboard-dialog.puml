@startuml
title UML sequence behaviour — Operate a dialog by keyboard
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Keyboard user" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ProfilePage" as page
  participant "EditProfileDialog (CDK)" as dlg
end box
actor -> page : Tab to "Edit profile" (visible focus, L2-038 AC2)
actor -> page : Enter
page -> dlg : open()
dlg -> dlg : Move focus to first field; trap Tab
actor -> dlg : Esc
dlg --> page : close(); restore focus to trigger
@enduml
