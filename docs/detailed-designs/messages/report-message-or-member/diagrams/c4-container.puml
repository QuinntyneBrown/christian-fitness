@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Report a message or member

Person(member, "Member", "Signed-in member")
Person(staff, "Staff member", "Reviews flagged members")
System_Boundary(cf, "Christian Fitness") {
  Container(web, "Member web app", "Angular, standalone, signals, zoneless", "projects/web: Messages screen")
  Container(admin, "Admin web app", "Angular", "Members moderation console")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers and SignalR ChatHub")
  Container(cli, "Christian Fitness CLI", ".NET console", "Migrations and idempotent seed")
  ContainerDb(db, "Christian Fitness database", "EF Core; engine <TO SUPPLY>", "Conversations, participants, messages, reports")
}
System_Ext(otel, "OpenTelemetry collector", "Traces and metrics")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "POST /api/messages/{id}/reports", "JSON/HTTPS")
Rel(staff, admin, "Reviews flagged members in", "HTTPS")
Rel(admin, api, "Calls staff endpoints (StaffOnly)", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(cli, db, "Migrates and seeds", "EF Core")
Rel(api, otel, "Exports telemetry to", "OTLP")
@enduml
