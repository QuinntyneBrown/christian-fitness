@startuml
title UML sequence behaviour — Report a message or member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ConversationPage" as page
  participant "ReportMessageDialog" as dlg
  participant "HttpReportsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "ReportsController" as controller
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ReportMessageHandler" as handler
  participant "Member" as sender
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Choose Report on another member's message
page -> dlg : Open CDK Dialog with message id
actor -> dlg : Enter reason and submit
dlg -> client : reportMessage(id, reason)
client -> controller : POST /api/messages/{id}/reports
controller -> controller : Authenticate (fallback policy)
controller -> handler : Send ReportMessageCommand
handler -> db : Load message in ChatMessages, then DirectMessages (ADR 0000)
alt unknown message, or caller not in its conversation
  handler --> controller : code message_not_found
  controller --> client : 404 ProblemDetails (code message_not_found)
  client --> dlg : Error with code
  dlg --> actor : Generic error message
else caller is the sender
  handler --> controller : code cannot_report_own_message
  controller --> client : 403 ProblemDetails (code cannot_report_own_message)
  client --> dlg : Error with code
  dlg --> actor : Generic error message
else same reporter already reported this message
  db --> handler : Existing MessageReport
  handler --> controller : code already_reported, no second row
  controller --> client : 409 ProblemDetails (code already_reported)
  client --> dlg : Error with code
  dlg --> actor : Already reported (generic message)
else first report
  handler -> db : Insert MessageReport (ReporterId, MessageId, SenderId, Reason)
  handler -> sender : TryFlag("Reported by a member")
  note right of sender : Active becomes Flagged; Flagged stays Flagged; Suspended stays Suspended
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Success
  controller --> client : 201 Created
  client --> dlg : Done
  dlg --> actor : Success state "Message reported"
  dlg -> dlg : Close by its ref
end
@enduml
