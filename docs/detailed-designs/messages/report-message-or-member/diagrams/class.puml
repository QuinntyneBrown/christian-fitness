@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Report a message or member

enum MemberStatus {
  Active
  Flagged
  Suspended
}
class Member {
  +Guid Id
  +string DisplayName
  +MemberStatus Status
  +TryFlag(note: string): bool
}
class Message {
  +Guid Id
  +Guid ConversationId
  +Guid SenderId
}
class MessageReport {
  +Guid Id
  +Guid ReporterId
  +Guid MessageId
  +Guid SenderId
  +string Reason
  +DateTimeOffset CreatedAt
}
note right of MessageReport : Unique (ReporterId, MessageId)
class ReportMessageCommand {
  +Guid MessageId
  +string Reason
}
class ReportMessageValidator {
  Reason optional, at most 500 characters (field_too_long)
}
class ReportMessageHandler {
  +Handle(cmd: ReportMessageCommand): Task<Result>
  message_not_found 404, cannot_report_own_message 403, already_reported 409
}
class ReportsController {
  +Report(messageId, body): Task<IActionResult>
}
interface ReportsApi <<api>> {
  +reportMessage(id: string, reason: string): Observable<void>
}
class HttpReportsService
class ReportMessageDialog

Member --> MemberStatus
MessageReport --> Message : about
MessageReport --> Member : sender
Message --> Member : sender
ReportsController ..> ReportMessageCommand : sends
ReportMessageHandler ..> ReportMessageCommand : handles
ReportMessageHandler ..> ReportMessageValidator : validates
ReportMessageHandler ..> MessageReport : creates once
ReportMessageHandler ..> Member : TryFlag()
HttpReportsService ..|> ReportsApi
ReportMessageDialog ..> ReportsApi : REPORTS_SERVICE
@enduml
