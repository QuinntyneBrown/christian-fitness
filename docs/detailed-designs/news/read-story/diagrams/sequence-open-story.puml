@startuml
title UML sequence behaviour — open a story
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Visitor or member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "StoryPage" as page
  participant "StoriesApi (STORIES_SERVICE)" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "PublicStoriesController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetPublishedStoryHandler" as h
  participant "StoryText" as text
  participant "CountStoryReadHandler" as count
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Open /stories/<slug>
page --> actor : Skeletons for headline, image and text (L2-061 AC9)
page -> client : get(slug)
client -> ctrl : GET /api/public/stories/{slug}
ctrl -> h : Send GetPublishedStoryQuery
h -> h : PublicReadLimiter.TryAcquire(network) (L2-060 AC7)
h -> db : Story by slug, else StorySlugRedirect by former slug
db --> h : Story
alt no story, or status is not Published
  h --> ctrl : RefusalException not_found
  ctrl --> client : 404 ProblemDetails, nothing of the story (L2-061 AC7)
  client --> page : ApiError not_found
  page --> actor : Not-found view, address kept
else published
  h -> text : Paragraphs(text), ReadingMinutes(text)
  text --> h : Paragraphs with IsQuote; max(1, ceil(words / 220)) (L2-061 AC2)
  h -> db : Pointed event or listing, if still published (L2-061 AC4)
  h -> db : 3 other published stories, same section first, newest first (L2-061 AC6)
  db --> h : Rows
  h --> ctrl : PublishedStoryDto
  ctrl --> client : 200 JSON
  client --> page : PublishedStoryDto
  opt dto.slug differs from the slug opened
    page -> page : Replace the URL with /stories/<dto.slug> (L2-061 AC8)
  end
  page -> page : Title and meta description from headline and summary (L2-061 AC11)
  page --> actor : Section, h1, summary, byline, age, reading time, image, text as text (L2-061 AC1, AC10)
  page -> client : countRead(id)
  client -> ctrl : POST /api/public/stories/{id}/reads
  ctrl -> count : Send CountStoryReadCommand
  count -> db : Add 1 to StoryReadTally(story, Toronto day)
  count --> ctrl : Done
  ctrl --> client : 204
end
@enduml
