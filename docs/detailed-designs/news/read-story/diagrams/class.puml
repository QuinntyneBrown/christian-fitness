@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Read a story

enum StoryStatus {
  Draft
  InReview
  Scheduled
  Published
}
class Story <<entity>> {
  +Guid Id
  +string? Slug
  +string[] FormerSlugs
  +string Headline
  +string Summary
  +string Text
  +StorySection? Section
  +Guid? BylineId
  +string? ImageKey
  +StoryPointer PointsTo
  +DateTimeOffset? PublishedAt
}
class StoryReadTally <<entity>> {
  +Guid StoryId
  +DateOnly Day
  +int Count <<concurrency token>>
  +{static} First(storyId, day)
  +Add()
}
class StoryReaders <<domain rule>> {
  +{static} Counts(userAgent): bool
}
class PublishedStories {
  +{static} At(db, now): IQueryable<Story>
  +{static} FindAsync(db, slug, now): Story?
}
class GetPublishedStoryHandler {
  +Handle(GetPublishedStoryQuery): PublishedStoryDto
}
class PublishedStoryDto {
  +Guid Id
  +string Slug
  +string? Section
  +string Headline
  +string Summary
  +string? Author
  +DateTimeOffset PublishedAt
  +string Text
  +StoryImageDto? Image
  +StoryNextDto? Next
  +StoryCardDto[] KeepReading
}
class GetStoryShellHandler {
  +Handle(GetStoryShellQuery): StoryShellAnswer
}
interface IStoryShell {
  +GetAsync(): string?
}
class HttpStoryShell <<infrastructure>> {
  -shell: string?
}
class CountStoryReadHandler {
  +Handle(CountStoryReadCommand)
}
class StoryPage <<Angular page>> {
  -story: Signal<PublishedStoryDto>
  -copiedFlag: CopiedFlag
  +copyLink(): Promise<void>
}
interface StoriesApi <<STORIES_SERVICE>> {
  +get(slug): Observable<PublishedStoryDto>
}
interface ClipboardApi <<CLIPBOARD_SERVICE>> {
  +write(text): Promise<boolean>
}
interface StoryReadsApi <<STORY_READS>> {
  +count(storyId): void
}
class LocalStoryReads {
  uses storyReadLog
}
Story --> StoryStatus
Story "1" <-- "*" StoryReadTally : counts
PublishedStories ..> Story : current or former slug, Published or due Scheduled
GetPublishedStoryHandler ..> PublishedStories
GetPublishedStoryHandler ..> PublishedStoryDto : answers
GetStoryShellHandler ..> PublishedStories
GetStoryShellHandler ..> IStoryShell
HttpStoryShell ..|> IStoryShell
CountStoryReadHandler ..> StoryReaders
CountStoryReadHandler ..> StoryReadTally : adds one, retries a lost race
StoryPage ..> StoriesApi
StoryPage ..> ClipboardApi
StoryPage ..> StoryReadsApi
LocalStoryReads ..|> StoryReadsApi
@enduml
