@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Subscribe to the newsletter

enum SubscriptionStatus {
  Pending
  Subscribed
  Unsubscribed
}
class NewsletterSubscription <<entity>> {
  +Guid Id
  +string Email
  +SubscriptionStatus Status
  +DateTimeOffset RequestedAt
  +DateTimeOffset? ConsentedAt
  +string? ConsentSource
  +DateTimeOffset? UnsubscribedAt
  +{static} Request(email, now): NewsletterSubscription
  +RequestAgain(now): bool
  +IsPurgeableAt(now): bool
}
class SubscriptionConfirmation <<entity>> {
  +Guid Id
  +Guid SubscriptionId
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? UsedAt
  +{static} Issue(subscriptionId, now): (SubscriptionConfirmation, string)
}
class SubscribeCommand {
  +string Email
}
class SubscribeHandler {
  +Handle(command): Task
}
class SubscriptionLimiter {
  +const int Limit = 5
  +Window = 1 hour
}
abstract class AddressRateLimiter {
  +TryAcquire(partitionKey): Lease?
}
class NewsletterEmails {
  +Confirmation(subscription, token, now): EmailMessage
}
interface IEmailSender {
  +SendAsync(message, ct): Task
}
class SubscribePage <<Angular page>>
class SubscribeRules <<domain>> {
  +subscribeEmailErrorOf(email): string?
  +subscribeRefusalOf(failure): string
}
interface NewsletterApi <<NEWSLETTER_SERVICE>> {
  +subscribe(request): Observable<void>
}
NewsletterSubscription --> SubscriptionStatus
NewsletterSubscription "1" *-- "*" SubscriptionConfirmation
AddressRateLimiter <|-- SubscriptionLimiter
SubscribeHandler ..> SubscribeCommand : handles
SubscribeHandler ..> SubscriptionLimiter
SubscribeHandler ..> NewsletterSubscription
SubscribeHandler ..> SubscriptionConfirmation : issues
SubscribeHandler ..> NewsletterEmails
SubscribeHandler ..> IEmailSender
SubscribePage ..> NewsletterApi
SubscribePage ..> SubscribeRules
@enduml
