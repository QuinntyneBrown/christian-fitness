@startuml
title UML sequence behaviour — read a feed
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Feed reader" as actor
box "Backend — Christian Fitness API" #D1FADF
  participant "public-reads policy" as limit
  participant "Feed output cache" as cache
  participant "FeedsController" as ctrl
  participant "RssFeedResult" as rss
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetStoryFeedHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> limit : GET /feed or /{section}/feed, with If-None-Match / If-Modified-Since
limit -> limit : Count request for client IP (L2-034 AC4)
alt limit reached
  limit --> actor : 429 ProblemDetails too_many_requests; Retry-After (L2-034 AC5)
else allowed
limit -> cache : Check cached feed
alt fresh cache entry
  cache --> actor : Cached feed or 304 if validators match
else cache miss
cache -> ctrl : Forward request
ctrl -> h : Send GetStoryFeedQuery(section, validators)
alt section unknown
  h --> ctrl : RefusalException not_found
  ctrl --> actor : 404 ProblemDetails
else known feed
  h -> db : 30 newest Published stories of the feed (L2-060 AC1, AC6)
  db --> h : Id, slug, title, summary, section, byline, PublishedAt, EditedAt
  h -> h : ETag = hash of ids and EditedAt; Last-Modified = newest change
  alt validators match
    h --> ctrl : StoryFeed NotModified
    ctrl --> actor : 304, no body (L2-060 AC2)
  else changed
    h --> ctrl : StoryFeed with items
    ctrl -> rss : new RssFeedResult(feed)
    rss --> cache : 200 application/rss+xml; Cache-Control public, max-age=900; ETag; Last-Modified; no Set-Cookie
    cache -> cache : Store rendered feed for 15 minutes
    cache --> actor : Feed response
  end
end
end
end
@enduml
