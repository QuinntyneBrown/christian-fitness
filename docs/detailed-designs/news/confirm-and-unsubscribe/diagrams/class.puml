@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Confirm and unsubscribe

class NewsletterSubscription <<entity>> {
  +Guid Id
  +string Email
  +SubscriptionStatus Status
  +DateTimeOffset? ConsentedAt
  +string? ConsentSource
  +DateTimeOffset? UnsubscribedAt
  +Confirm(now): void
  +Unsubscribe(now): void
  +IsPurgeableAt(now): bool
}
class SubscriptionConfirmation <<entity>> {
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? UsedAt
  +IsUsableAt(now): bool
  +Use(now): void
}
class ConfirmSubscriptionCommand {
  +string Token
}
class ConfirmSubscriptionHandler {
  +Handle(command): Task<SubscriptionConfirmedDto>
}
class SubscriptionConfirmedDto {
  +string Email
  +DateTimeOffset FirstIssueAt
}
class UnsubscribeCommand {
  +string Token
}
class UnsubscribeHandler {
  +Handle(command): Task<UnsubscribedDto>
}
class UnsubscribedDto {
  +string? Email
}
class NewsletterUnsubscribeToken <<entity>> {
  +Guid SubscriptionId
  +string TokenHash
  +DateTimeOffset IssuedAt
  +{static} Issue(subscriptionId, now): (NewsletterUnsubscribeToken, string)
}
class NewsletterEmails {
  +Confirmation(subscription, token, now): EmailMessage
  -WithFooter(subscription, text, now): EmailMessage
}
class EmailMessage {
  +string To
  +string Subject
  +string Text
  +Headers: List-Unsubscribe, List-Unsubscribe-Post only
}
class PurgeNewsletterSubscriptionsCommand
class PublishingClock <<BackgroundService>>
NewsletterSubscription "1" *-- "*" SubscriptionConfirmation
ConfirmSubscriptionHandler ..> ConfirmSubscriptionCommand : handles
ConfirmSubscriptionHandler ..> SubscriptionConfirmation : uses once
ConfirmSubscriptionHandler ..> NewsletterSubscription : confirms
ConfirmSubscriptionHandler ..> SubscriptionConfirmedDto
UnsubscribeHandler ..> UnsubscribeCommand : handles
UnsubscribeHandler ..> NewsletterUnsubscribeToken : finds by hash
UnsubscribeHandler ..> NewsletterSubscription : unsubscribes
UnsubscribeHandler ..> UnsubscribedDto
NewsletterSubscription "1" *-- "*" NewsletterUnsubscribeToken
NewsletterEmails ..> NewsletterUnsubscribeToken : issues
NewsletterEmails ..> EmailMessage : builds
PublishingClock ..> PurgeNewsletterSubscriptionsCommand : sends each tick
@enduml
