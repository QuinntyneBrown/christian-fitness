@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Confirm and unsubscribe

Container_Boundary(web, "Member web app") {
  Component(page, "SubscribePage", "Routed page /subscribe", "Reads #confirm= or #unsubscribe= once and drops it")
  Component(frag, "takeFragmentToken", "Domain library", "Reads a named token from a fragment")
  Component(client, "HttpNewsletterService", "NEWSLETTER_SERVICE", "confirm(token), unsubscribe(token)")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "PublicNewsletterController", "ASP.NET Core controller, anonymous", "POST confirmations, POST unsubscriptions, POST unsubscribe")
  Component(confirm, "ConfirmSubscriptionHandler", "MediatR handler", "Single-use, 7-day token")
  Component(unsub, "UnsubscribeHandler", "MediatR handler", "Newsletter and every extra at once")
  Component(tokens, "INewsletterTokens", "Application contract", "Random unsubscribe tokens and stored hashes")
  Component(clock, "PublishingClock", "BackgroundService", "Leased 30-second scheduler")
  Component(upkeep, "NewsletterUpkeep", "Daily scheduler job", "Sends PurgeUnsubscribedCommand")
  Component(purge, "PurgeUnsubscribedHandler", "MediatR handler", "Deletes addresses at least 29 days after unsubscribing")
}
ContainerDb(db, "Christian Fitness database", "PostgreSQL", "Subscriptions and token hashes")
Rel(page, frag, "Uses")
Rel(page, client, "Calls")
Rel(client, ctrl, "JSON/HTTPS")
Rel(ctrl, confirm, "Sends ConfirmSubscriptionCommand")
Rel(ctrl, unsub, "Sends UnsubscribeCommand")
Rel(unsub, tokens, "Looks up the token hash")
Rel(tokens, db, "Stores and looks up token hashes", "IAppDbContext")
Rel(clock, upkeep, "Runs daily")
Rel(upkeep, purge, "Sends PurgeUnsubscribedCommand")
Rel(confirm, db, "Reads and writes", "IAppDbContext")
Rel(unsub, db, "Writes", "IAppDbContext")
Rel(purge, db, "Deletes", "IAppDbContext")
@enduml
