@startuml
title UML sequence behaviour — Open a URL no route matches
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member or staff" as actor
box "Frontend — Member web app or Admin web app" #E0F2FE
  participant "Router" as router
  participant "NotFoundPage" as page
  participant "ErrorPage" as block
end box
actor -> router : Open /no-such-page
router -> router : No route matches; wildcard route
router -> page : loadComponent, a lazy chunk (L2-043 AC1)
router -> actor : Title "Page not found · Christian Fitness" (or "· Christian Fitness Admin")
page -> block : code 404, heading, text and two Button links
block -> block : Focus the heading; the code is aria-hidden (L2-043 AC7)
block --> actor : Page not found; the URL is unchanged (L2-043 AC1)
actor -> page : Choose "Go to home" or "Go to dashboard"
page --> actor : Document load of / (L2-043 AC2)
@enduml
