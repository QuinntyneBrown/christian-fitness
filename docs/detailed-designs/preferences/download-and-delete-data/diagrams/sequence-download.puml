@startuml
title UML sequence behaviour — request and deliver a download
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "PreferencesPage" as page
  participant "DataApi (DATA_SERVICE)" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "DataController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "RequestDataExportHandler" as req
  participant "DataExportBuilder (cf export-data)" as builder
  participant "GetDataExportArchiveHandler" as get
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
  participant "IArchiveStore" as store
  participant "IEmailSender" as mail
end box
actor -> page : Request download
page -> client : requestDownload()
client -> ctrl : POST /api/data-exports
ctrl -> req : Send RequestDataExportCommand
req -> db : Request of mine in the last 24 hours?
alt none
  req -> db : Add DataExportRequest and AuditEntry data_export.requested (L2-066 AC10)
else one exists
  req -> req : Answer the existing request (AC3)
end
req --> ctrl : DataExportStatusDto(requestedAt)
ctrl --> client : 200 JSON
client --> page : Requested
page --> actor : "Requested. We'll email you a link within 24 hours." (role=status, AC1)
== Scheduled run, within 24 hours ==
builder -> db : Requests without an archive; member's own data
db --> builder : Profile, preferences, registrations, follows, suggestions, feedback, sent messages
builder -> store : Save .zip (no other person's messages, email or profile, AC2)
builder -> db : ReadyAt, ArchiveKey, ExpiresAt = ReadyAt + 7 days
builder -> mail : Link /preferences/download/{id} to the account's address
== Member follows the link ==
actor -> page : Open /preferences/download/{id} (sign in first if needed)
page -> ctrl : GET /api/data-exports/{id}/archive
ctrl -> get : Send GetDataExportArchiveQuery
get -> db : Request by id
alt caller's own and not expired
  get -> store : Open archive
  store --> get : Stream
  get --> ctrl : application/zip
else another member's, expired or unknown
  get --> ctrl : 404 not_found (AC2)
end
ctrl --> actor : Download, or not found
@enduml
