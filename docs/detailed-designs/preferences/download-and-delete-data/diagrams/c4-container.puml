@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Download and delete data

Person(member, "Member", "Signed-in member")
System_Boundary(cf, "Christian Fitness") {
  Container(web, "Member web app", "Angular", "Your data section, DeleteAccountDialog, download page")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Data and account controllers, chat hub, sign-in, scheduled jobs (erasure every tick)")
  ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Members, DataExportRequests, sessions, messages")
  ContainerDb(files, "Archive store", "File share /data", "Private .zip archives, 7 days")
}
System_Ext(mail, "Email provider", "SMTP relay")
Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS, cookie session")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, files, "Writes, expires and streams archives")
Rel(api, mail, "Sends the link and the deletion emails", "SMTP")
@enduml
