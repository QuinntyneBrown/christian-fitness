@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Drop in on dates of a series

class Event {
  +Guid Id
  +DateTimeOffset StartsAt
  +int Capacity
  +int PriceCents
  +EventStatus Status
  +Guid? SeriesId
  +int RegistrationVersion
  +TakePlace(): void
  +ReleasePlace(): void
}
class Registration {
  +Guid EventId
  +Guid MemberId
  +RegistrationStatus Status
  +{static} Of(eventId, memberId, priceCents, createdAt): Registration
}
class SetDropInDatesCommand {
  +Guid SeriesId
  +Guid[] SessionIds
}
class SetDropInDatesHandler {
  +Handle(c: SetDropInDatesCommand): Task<SeriesDetailDto>
}
class RefusalException {
  +string Code = "event_full"
  +Extensions: sessions = int[]
}
interface EventSeriesApi {
  +setDropIns(id, sessionIds): Observable<SeriesDetailDto>
}
class EventSeriesPage {
  +plan: Signal<'all' | 'drop'>
  +picked: Signal<ReadonlySet<string>>
  +changing: Signal<boolean>
  +tick(sessionId, on): void
  +register(): void
  +changeDates(): void
  +saveDates(): void
}
class DropInPick <<domain>> {
  +note: string
  +button: label, disabled, busy
  +booked: confirmed, sessions, pay
}
class StopDatesDialog {
  +stop(): void
}
EventSeriesPage ..> StopDatesDialog : opens when a held date is unticked
StopDatesDialog ..> EventSeriesApi
EventSeriesPage ..> EventSeriesApi : EVENT_SERIES_SERVICE
EventSeriesPage ..> DropInPick
SetDropInDatesHandler ..> SetDropInDatesCommand : handles
SetDropInDatesHandler ..> Registration : adds and removes
SetDropInDatesHandler ..> Event : TakePlace / ReleasePlace
SetDropInDatesHandler ..> RefusalException : throws
Event "1" o-- "*" Registration
@enduml
