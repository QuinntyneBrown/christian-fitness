@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse and filter events

Container_Boundary(web, "Member web app") {
  Component(page, "EventsPage", "Angular routed page", "View switch, chip bar, event grid, states")
  Component(card, "EventCard, ChipBar, DateBadge", "components library", "Presentation; event-card__series line")
  Component(feed, "EventFeed, sessionLineOf", "domain library", "200-event window; series line words")
  Component(svc, "HttpEventsService", "EVENTS_SERVICE", "GET /api/events")
  Component(series, "Series view", "Lazy component (browse-event-series)", "Shown at /events?view=series")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "EventsController", "ASP.NET Core controller", "GET /api/events")
  Component(val, "ListEventsValidator", "FluentValidation", "Category and cursor shape")
  Component(h, "ListEventsHandler", "MediatR handler", "Published, upcoming, category, page of 20, series line")
  Component(reg, "IRegistrationReader", "Application abstraction", "Going counts")
  Component(ctx, "IAppDbContext", "Application abstraction", "Events and series sets")
  Component(ent, "Event", "Domain entity", "Status, StartsAt, Category, Capacity, HostListingId, SeriesId")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Events, series, registrations")
Rel(page, card, "Renders")
Rel(page, feed, "Holds")
Rel(page, svc, "page(cursor, category)")
Rel(page, series, "Loads lazily when view=series")
Rel(svc, ctrl, "GET /api/events", "JSON/HTTPS")
Rel(ctrl, h, "Sends ListEventsQuery")
Rel(h, val, "Validated by")
Rel(h, reg, "Reads going")
Rel(h, ctx, "Queries")
Rel(ctx, ent, "Materializes")
Rel(ctx, db, "Reads", "EF Core")
@enduml
