@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Browse and filter events

enum EventCategory {
  Run
  Workout
  Basketball
  Mobility
  Workshop
  Retreat
}
enum EventStatus {
  Draft
  Published
  Cancelled
}
class Event {
  +Guid Id
  +string Title
  +EventCategory Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +int PriceCents
  +int Capacity
  +string Summary
  +string? ImageKey
  +EventStatus Status
  +Guid HostListingId <<new>>
  +Guid? SeriesId <<new>>
}
class "EventSeries (browse-event-series)" as EventSeries {
  +Guid Id
  +string Cadence
}
class "Listing (directory)" as Listing {
  +Guid Id
  +string Name
}
class ListEventsQuery {
  +string? Cursor
  +string? Category
}
class ListEventsValidator
class ListEventsHandler {
  +Handle(query: ListEventsQuery): Task<EventPageDto>
}
class EventPageDto {
  +EventSummaryDto[] Events
  +string? NextCursor
}
class EventSummaryDto {
  +Guid Id
  +string Title
  +string Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +int PriceCents
  +int Capacity
  +int Going
  +string? ImageKey
  +SeriesSessionDto? SeriesSession <<new>>
}
class SeriesSessionDto <<new>> {
  +Guid SeriesId
  +int Number
  +int Total
  +string Cadence
}
interface EventsApi {
  +page(cursor, category?): Observable<EventPageDto>
}
interface IRegistrationReader
class "sessionLineOf(summary)" as sessionLine <<function>> {
  "Session <n> of <total> · <cadence>" or none
}
class EventCard {
  +event: input<EventSummary>
}
class HttpEventsService
class EventsPage {
  +view: Signal<'date' | 'series'>
  +seriesCount: Signal<number | null>
  +category: Signal<EventCategory | null>
  +selectCategory(c): void
  +clearFilter(): void
  +loadMore(): void
}
class EventFeed {
  +items: EventSummaryDto[]
  +nextCursor: string | null
  +append(page: EventPageDto): EventFeed
  +reset(): EventFeed
}
HttpEventsService ..|> EventsApi
EventsPage ..> EventsApi : EVENTS_SERVICE
EventsPage *-- EventFeed
ListEventsHandler ..> ListEventsQuery : handles
ListEventsHandler ..> Event : reads
ListEventsHandler ..> EventSeries : reads cadence, total
ListEventsHandler ..> IRegistrationReader : going
ListEventsValidator ..> ListEventsQuery : validates
EventSummaryDto *-- "0..1" SeriesSessionDto
Event --> "0..1" EventSeries
Event --> "1" Listing : hosted by
EventsPage --> EventCard
EventCard ..> sessionLine
ListEventsHandler ..> EventPageDto : returns
EventPageDto "1" *-- "0..20" EventSummaryDto
Event --> EventCategory
Event --> EventStatus
@enduml
