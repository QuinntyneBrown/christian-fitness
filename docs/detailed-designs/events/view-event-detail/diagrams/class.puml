@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View event detail

class Event {
  +Guid Id
  +string Title
  +EventCategory Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +int PriceCents
  +int Capacity
  +string Summary
  +string? ImageKey
  +EventStatus Status
  +Guid HostListingId <<new>>
  +Guid? SeriesId <<new>>
}
class Registration {
  +Guid EventId
  +Guid MemberId
  +RegistrationStatus Status
}
class Conversation {
  +Guid Id
  +Guid? EventId
}
class "Listing (directory)" as Listing {
  +Guid Id
  +string Name
  +string Kind
  +bool Verified
}
class "EventSeries (view-event-series)" as EventSeries {
  +Guid Id
  +string Title
  +string Cadence
}
class GetEventQuery {
  +Guid Id
}
class GetEventHandler {
  +Handle(query: GetEventQuery): Task<EventDetailDto>
}
class EventDetailDto {
  +Guid Id
  +string Title
  +string Category
  +DateTimeOffset StartsAt
  +string Place
  +string Area
  +int PriceCents
  +int Capacity
  +int Going
  +string Summary
  +string? ImageKey
  +string? Registration
  +EventHostDto Host <<new>>
  +EventSeriesCardDto? Series <<new>>
}
class EventHostDto <<new>> {
  +Guid Id
  +string Name
  +string Kind
  +string Initials
  +bool Verified
}
class EventSeriesCardDto <<new>> {
  +Guid Id
  +string Title
  +string Cadence
  +int Number
  +int Total
  +bool Joined
  +NextSessionDto[] Next
}
class NextSessionDto <<new>> {
  +Guid? EventId
  +DateTimeOffset StartsAt
  +string Topic
}
interface EventsApi {
  +get(id): Observable<EventDetailDto>
}
class EventDetailPage {
  +event: Signal<EventDetailDto | null>
  +chatHref(): string
}
class HostCard {
  +name, kind, initials, href: input<string>
  +verified: input<boolean>
}
class SeriesCard {
  +meta, title, href: input<string>
  +dates: input<{when, topic}[]>
  +joined: input<boolean>
}
Event "1" --> "*" Registration
Event "1" --> "0..1" Conversation : group chat
Event --> "1" Listing : hosted by
Event --> "0..1" EventSeries : session of
GetEventHandler ..> GetEventQuery : handles
GetEventHandler ..> EventDetailDto : returns
GetEventHandler ..> Listing : reads
GetEventHandler ..> EventSeries : reads
EventDetailDto *-- EventHostDto
EventDetailDto *-- "0..1" EventSeriesCardDto
EventSeriesCardDto *-- "0..3" NextSessionDto
EventDetailPage ..> EventsApi : EVENTS_SERVICE
EventDetailPage --> HostCard
EventDetailPage --> SeriesCard
@enduml
