@startuml
title UML sequence behaviour — Suspend a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "MembersPage" as page
  participant "ModerationDialog <TO SUPPLY>" as dlg
  participant "HttpAdminMembersService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminMembersController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SuspendMemberHandler" as h
  participant "Member" as ent
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "Session store" as sess
  database "Christian Fitness database" as db
end box
actor -> page : Suspend on an Active or Flagged member's row
page -> dlg : Open CDK Dialog
actor -> dlg : Enter note and confirm
dlg -> client : suspend(id, note)
client -> ctrl : POST /api/admin/members/{id}/suspend
ctrl -> ctrl : Authenticate and apply StaffOnly policy
ctrl -> h : Send SuspendMemberCommand (validated: note and confirmation)
alt target is the caller
  h --> ctrl : Refusal cannot_moderate_self (L2-029 AC4)
  ctrl --> client : ProblemDetails, code cannot_moderate_self
  client --> dlg : cannot_moderate_self
  dlg --> actor : Generic message
else another member
  h -> db : Load member
  db --> h : Member
  h -> ent : Suspend(note)
  ent --> h : Status Suspended (L2-029 AC2)
  h -> db : Save changes
  db --> h : Committed
  h -> sess : Revoke every session of the member
  sess --> h : Sessions ended
  h --> ctrl : Success
  ctrl --> client : 204 No Content
  client --> dlg : Done
  dlg -> dlg : Close by its ref
  page --> actor : Row shows Suspended
  note over h, db : Afterwards sign-in and event registration refuse with account_suspended (L2-004 AC4, L2-011 AC6)
end
@enduml
