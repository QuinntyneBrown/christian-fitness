@startuml
title UML sequence behaviour — Suspend a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "AdminMembersPage" as page
  participant "ModerateMemberDialog" as dlg
  participant "HttpAdminMembersService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminMembersController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SuspendMemberHandler" as h
  participant "ModerationTarget" as target
  participant "Member" as ent
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "ISessionRevocation" as sess
  database "Christian Fitness database" as db
end box
actor -> page : Moderate on an Active or Flagged member's row
page -> dlg : Import on first use, open as a CDK Dialog
actor -> dlg : Choose Suspend, write the note, confirm
alt no note, a note over 500 characters or no confirmation
  dlg --> actor : Error summary and each field's error; nothing sent (L2-029 AC5)
else
  dlg -> client : suspend(id, note)
  client -> ctrl : POST /api/admin/members/{id}/suspend { note, confirmed: true }
  ctrl -> ctrl : Authenticate; Members staff area admits Admin and Moderator
  ctrl -> h : Send SuspendMemberCommand (validated: note_required, note_too_long, confirmation_required)
  h -> target : FindAsync(id)
  target -> db : Load the member and both staff roles
alt unknown id
  target --> h : Refusal member_not_found (404, L2-029 AC6)
else the member is the caller
  target --> h : Refusal cannot_moderate_self (403, L2-029 AC4)
else a Moderator and a staff account
  target --> h : Refusal forbidden_role (403, L2-029 AC7)
else
  target --> h : Member
end
  alt refused
    h --> ctrl : RefusalException
    ctrl --> client : ProblemDetails with the code
    client --> dlg : ApiError
    dlg --> actor : The refusal's own sentence, note kept
  else
    h -> ent : TrySuspend(note)
    alt already Suspended
      ent --> h : false
      h --> ctrl : Refusal status_conflict (409, L2-029 AC6)
    else Active or Flagged
      ent --> h : Suspended, note kept (L2-029 AC2)
      h -> sess : EndAllAsync(member)
      h -> db : Remove pending admin sign-ins; save once
      db --> h : Committed: status, note, sessions gone
      h --> ctrl : MemberRowDto
      ctrl --> client : 200 OK
      client --> dlg : The member as they now are
      dlg -> dlg : Close by its ref
      page --> actor : Toast, the list again, focus on the table
      note over h, db : Afterwards sign-in refuses with account_suspended in both apps (L2-004 AC4, L2-029 AC8)
    end
  end
end
@enduml
