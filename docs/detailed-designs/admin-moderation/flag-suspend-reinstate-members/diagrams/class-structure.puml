@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Flag, suspend and reinstate members

enum MemberStatus {
  Active
  Flagged
  Suspended
}
class Member {
  +Guid Id
  +MemberStatus Status
  +string? ModerationNote
  +Flag(note: string): void
  +Suspend(note: string): void
  +Reinstate(): void
}
class FlagMemberCommand {
  +Guid MemberId
  +string Note
}
class SuspendMemberCommand {
  +Guid MemberId
  +string Note
  +bool Confirmed
}
class ReinstateMemberCommand {
  +Guid MemberId
}
class FlagMemberValidator
class SuspendMemberValidator
class FlagMemberHandler
class SuspendMemberHandler
class ReinstateMemberHandler
interface ICurrentMember {
  +Guid MemberId
  +StaffRole? Role
}
interface ISessionRevocation {
  +EndAllAsync(memberId: Guid): Task
}
interface IAppDbContext {
  +Members: DbSet<Member>
  +SaveChangesAsync(ct): Task<int>
}
enum StaffRole {
  Admin
  Moderator
}
Member --> MemberStatus : has
FlagMemberValidator ..> FlagMemberCommand : validates
SuspendMemberValidator ..> SuspendMemberCommand : validates
FlagMemberHandler ..> FlagMemberCommand : handles
SuspendMemberHandler ..> SuspendMemberCommand : handles
ReinstateMemberHandler ..> ReinstateMemberCommand : handles
SuspendMemberHandler --> ICurrentMember : refuses self
SuspendMemberHandler --> ISessionRevocation : ends sessions
FlagMemberHandler --> IAppDbContext
SuspendMemberHandler --> IAppDbContext
ReinstateMemberHandler --> IAppDbContext
ICurrentMember --> StaffRole
@enduml
