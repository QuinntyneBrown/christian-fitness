@startuml
title UML sequence behaviour — Reinstate a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "AdminMembersPage" as page
  participant "ModerateMemberDialog" as dlg
  participant "HttpAdminMembersService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminMembersController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ReinstateMemberHandler" as h
  participant "ModerationTarget" as target
  participant "Member" as ent
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Moderate on a Flagged or Suspended member's row
page -> dlg : Import on first use, open as a CDK Dialog
alt Flagged
  dlg --> actor : Reinstate (chosen) or Suspend
else Suspended
  dlg --> actor : Only reinstating: what it means, no field
end
actor -> dlg : Reinstate member
dlg -> client : reinstate(id)
client -> ctrl : POST /api/admin/members/{id}/reinstate (no body)
ctrl -> ctrl : Authenticate; Members staff area admits Admin and Moderator
ctrl -> h : Send ReinstateMemberCommand
h -> target : FindAsync(id)
target -> db : Load the member and both staff roles
alt unknown id, the caller's own account, or a Moderator and a staff account
  target --> h : Refusal member_not_found, cannot_moderate_self or forbidden_role
  h --> ctrl : RefusalException
  ctrl --> client : ProblemDetails with the code
  client --> dlg : ApiError
  dlg --> actor : The refusal's own sentence
else
  target --> h : Member
  h -> ent : TryReinstate()
  alt already Active
    ent --> h : false
    h --> ctrl : Refusal status_conflict (409, L2-029 AC6)
  else Flagged or Suspended
    ent --> h : Active, note cleared (L2-029 AC3)
    h -> db : Save
    h --> ctrl : MemberRowDto
    ctrl --> client : 200 OK
    client --> dlg : The member as they now are
    dlg -> dlg : Close by its ref
    page --> actor : Toast, the list again without the note
    note over h, db : A reinstated member signs in again; sessions a suspension ended stay ended
  end
end
@enduml
