@startuml
title UML sequence behaviour — Reinstate a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "MembersPage" as page
  participant "ModerationDialog <TO SUPPLY>" as dlg
  participant "HttpAdminMembersService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminMembersController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ReinstateMemberHandler" as h
  participant "Member" as ent
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> page : Reinstate on a Flagged or Suspended member's row
page -> client : reinstate(id)
client -> ctrl : POST /api/admin/members/{id}/reinstate
ctrl -> ctrl : Authenticate and apply StaffOnly policy
ctrl -> h : Send ReinstateMemberCommand
h -> db : Load member
db --> h : Member
h -> ent : Reinstate()
ent --> h : Status Active (L2-029 AC3)
h -> db : Save changes
db --> h : Committed
h --> ctrl : Success
ctrl --> client : 204 No Content
client --> page : Done
page --> actor : Row shows Active
@enduml
