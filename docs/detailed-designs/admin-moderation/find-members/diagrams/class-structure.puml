@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Find members

enum MemberStatus {
  Active
  Flagged
  Suspended
}
class Member {
  +Guid Id
  +string Name
  +string Email
  +string NormalizedEmail
  +string? HomeChurch
  +DateTimeOffset JoinedAt
  +MemberStatus Status
}
class SearchMembersQuery {
  +string? Search
  +string? Status
  +int? Page
  +{static} PageSize = 25
  +{static} SearchMaxLength = 100
}
class SearchMembersValidator {
  status: all, active, flagged or suspended
  search: 100 characters or fewer, trimmed
  page: 1 or more
}
class MemberRowDto {
  +Guid Id
  +string Name
  +string Email
  +string? HomeChurch
  +DateTimeOffset JoinedAt
  +int EventsAttended
  +string Status
}
class MemberListDto {
  +int Total
  +int Matches
  +int Page
  +int PageSize
  +IReadOnlyList<MemberRowDto> Members
}
class SearchMembersHandler {
  +Handle(q: SearchMembersQuery): Task<MemberListDto>
}
interface IAppDbContext {
  +Members: DbSet<Member>
}
interface IRegistrationReader {
  +CountsForAsync(memberIds): Task<IReadOnlyDictionary<Guid, int>>
}
class NoRegistrationsYet
interface AdminMembersApi {
  +search(query: AdminMemberQuery): Observable<AdminMemberListDto>
}
class AdminMemberQuery <<TypeScript>> {
  +status: all | active | flagged | suspended
  +q: string
  +page: number
}
class HttpAdminMembersService
class AdminMembersPage {
  #query: Signal<AdminMemberQuery>
  #term: Signal<string>
  #state: Signal<loading | ready | failed>
}
Member --> MemberStatus : has
SearchMembersValidator ..> SearchMembersQuery : validates
SearchMembersHandler ..> SearchMembersQuery : handles
SearchMembersHandler ..> MemberListDto : returns
MemberListDto o-- MemberRowDto
SearchMembersHandler --> IAppDbContext
SearchMembersHandler --> IRegistrationReader : events attended
NoRegistrationsYet ..|> IRegistrationReader : until slice 6.1
HttpAdminMembersService ..|> AdminMembersApi
AdminMembersApi ..> AdminMemberQuery
AdminMembersPage --> AdminMembersApi : ADMIN_MEMBERS_SERVICE
@enduml
