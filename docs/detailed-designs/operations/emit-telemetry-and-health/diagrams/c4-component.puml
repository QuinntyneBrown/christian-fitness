@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Emit telemetry and health

Container_Boundary(api, "Christian Fitness API") {
  Component(inst, "ASP.NET Core instrumentation", "OpenTelemetry", "Spans, http.server.request.duration, logs")
  Component(red, "TelemetryRedactionProcessor", "OpenTelemetry processor", "Keeps route, method, status, error type")
  Component(exp, "OTLP exporter", "OpenTelemetry", "Only when OTEL_EXPORTER_OTLP_ENDPOINT is set")
  Component(hc, "Health checks", "ASP.NET Core", "/health, /health/live, /health/ready (anonymous)")
  Component(dbhc, "DatabaseHealthCheck", "Infrastructure", "IAppDbContext.CanConnectAsync")
  ComponentDb(db, "Christian Fitness database", "EF Core", "Readiness probe")
}
System_Ext(otel, "OpenTelemetry collector", "")
Person(operator, "Operator", "")
Rel(inst, red, "Activities")
Rel(red, exp, "Redacted activities")
Rel(exp, otel, "OTLP")
Rel(operator, hc, "Probes")
Rel(hc, dbhc, "Ready tag")
Rel(dbhc, db, "CanConnect")
@enduml
