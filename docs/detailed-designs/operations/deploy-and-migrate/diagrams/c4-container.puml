@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deploy and migrate

Person(operator, "Operator", "Maintainer who deploys and monitors Christian Fitness")
System_Boundary(cf, "Christian Fitness") {
  Container(cli, "Christian Fitness CLI", ".NET console", "cf migrate, cf seed")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers and SignalR ChatHub")
  ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Members, events, conversations, listings")
}

Rel(operator, cli, "Runs migrate, then seed", "shell")
Rel(cli, db, "Applies migrations and seed", "EF Core")
Rel(operator, api, "Starts after migrate and seed", "dotnet")
Rel(api, db, "Reads and writes (no migration)", "EF Core")
@enduml
