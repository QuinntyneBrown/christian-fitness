@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Deploy and migrate

class MigrateCommand {
  +ExecuteAsync(): Task<int>
}
class SeedCommand {
  +ExecuteAsync(): Task<int>
}
class SeedRunner {
  +RunAsync(ct): Task<int> changes
}
class StaffAccountSeed {
  +Key = normalised staff email
}
class StaffSeedOptions {
  +StaffEmail: string
  +StaffPassword: string
  +StaffName: string
}
interface IAppDbContext <<Application>>
interface IPasswordHasherService <<Application>>
interface ISeed {
  +Key: string
  +ExistsAsync(db, ct): Task<bool>
  +Apply(db): void
}
class AppDbContext <<Infrastructure>>
AppDbContext ..|> IAppDbContext
ISeed <|.. StaffAccountSeed
StaffAccountSeed ..> StaffSeedOptions
StaffAccountSeed ..> IPasswordHasherService
MigrateCommand ..> AppDbContext
SeedCommand ..> SeedRunner
SeedRunner "1" o-- "*" ISeed
SeedRunner ..> IAppDbContext
@enduml
