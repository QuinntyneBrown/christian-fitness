@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View the landing page
package "Member web app and libraries" {
  class LandingPage {
    +section: Signal<NewsSection>
    +stories: Signal<StoriesState>
    +events: Signal<EventsState>
    +mostRead: Signal<StorySummaryDto[]>
    +retryStories(): void
    +retryEvents(): void
  }
  class newsSectionOf <<domain>> {
    +(value: string | null): NewsSection
  }
  class storyAge <<domain>> {
    +(publishedAt, now): string
  }
  class Masthead <<components>> {
    +sections: input<MastheadSection[]>
    +navigate: output<string>
  }
  class StoryLead <<components>>
  class HeadlineList <<components>>
  class River <<components>>
  class RankedList <<components>>
  class JoinCard <<components>>
  class EventRow <<components>>
  interface StoriesApi <<api>> {
    +get(slug): Observable<PublishedStoryDto>
    +frontPage(section, skip): Observable<FrontPageDto>
    +mostRead(): Observable<StorySummaryDto[]>
  }
  interface PublicEventsApi <<api>> {
    +upcoming(take: number): Observable<LandingEventDto[]>
  }
  class FrontPageDto <<api>> {
    +lead: StorySummaryDto | null
    +headlines: StorySummaryDto[]
    +latest: StorySummaryDto[]
    +more: boolean
  }
  class StorySummaryDto <<api>> {
    +id: string
    +slug: string
    +section: string
    +headline: string
    +summary: string | null
    +author: string | null
    +publishedAt: string
    +image: StoryImageDto | null
  }
  class LandingEventDto <<api>> {
    +id: string
    +title: string
    +category: EventCategory
    +startsAt: string
    +area: string
  }
}
package "Christian Fitness API, Application and Domain" {
  class PublicStoriesController
  class ListFrontPageStoriesQuery {
    +string? Section
  }
  class ListFrontPageStoriesHandler {
    +Handle(q): Task<FrontPageDto>
  }
  class ListMostReadStoriesQuery
  class ListMostReadStoriesHandler {
    +Handle(q): Task<IReadOnlyList<StorySummaryDto>>
  }
  class PublicEventsController
  class GetUpcomingEventsQuery {
    +int Take
    +{static} MaxTake = 4
  }
  class GetUpcomingEventsHandler
  class Story <<entity, authoring slice>> {
    +Guid Id
    +string Slug
    +StorySection Section
    +StoryStatus Status
    +DateTimeOffset? PublishedAt
  }
  class StoryReadTally <<entity, read-story>> {
    +Guid StoryId
    +DateOnly Day
    +int Count
  }
  class Event {
    +Guid Id
    +string Title
    +DateTimeOffset StartsAt
    +string Area
    +EventStatus Status
  }
  interface IAppDbContext
  class TimeProvider
}
LandingPage ..> StoriesApi : injects STORIES_SERVICE
LandingPage ..> PublicEventsApi : injects PUBLIC_EVENTS_SERVICE
LandingPage ..> newsSectionOf
LandingPage ..> storyAge
LandingPage --> Masthead
LandingPage --> StoryLead
LandingPage --> HeadlineList
LandingPage --> River
LandingPage --> RankedList
LandingPage --> JoinCard
LandingPage --> EventRow
StoriesApi ..> FrontPageDto
FrontPageDto "1" *-- "*" StorySummaryDto
PublicEventsApi ..> LandingEventDto
PublicStoriesController ..> ListFrontPageStoriesQuery : sends
PublicStoriesController ..> ListMostReadStoriesQuery : sends
ListFrontPageStoriesHandler ..> ListFrontPageStoriesQuery : handles
ListMostReadStoriesHandler ..> ListMostReadStoriesQuery : handles
ListFrontPageStoriesHandler ..> Story : Published only
ListMostReadStoriesHandler ..> StoryReadTally : last 7 days
ListMostReadStoriesHandler ..> TimeProvider
ListFrontPageStoriesHandler ..> IAppDbContext
PublicEventsController ..> GetUpcomingEventsQuery : sends
GetUpcomingEventsHandler ..> GetUpcomingEventsQuery : handles
GetUpcomingEventsHandler ..> Event : Published, StartsAt > now
GetUpcomingEventsHandler ..> TimeProvider
StorySummaryDto -[hidden]down- PublicStoriesController
LandingEventDto -[hidden]down- PublicEventsController
@enduml
