@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the landing page

Container_Boundary(web, "Member web app") {
  Component(guard, "redirectSignedInGuard", "CanActivateFn", "Sends a member to /home")
  Component(page, "LandingPage", "Angular routed component", "Masthead, top stories, river, rail, verse, footer")
  Component(ui, "Masthead, StoryLead, HeadlineList, River, RankedList, JoinCard", "components library", "masthead and story design-system pages")
  Component(rail, "EventRow, List, NewsletterBox, Footer", "components library", "Rail and footer blocks")
  Component(dom, "newsSectionOf, storyAge, eventCardViewOf", "domain helpers", "Section from the query; ages and dates in Toronto")
  Component(stories, "HttpStoriesService", "STORIES_SERVICE", "frontPage(section, skip), mostRead()")
  Component(events, "HttpPublicEventsService", "PUBLIC_EVENTS_SERVICE", "upcoming(4)")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(sctrl, "PublicStoriesController", "ASP.NET Core controller, AllowAnonymous", "GET /api/public/stories, GET /api/public/most-read-stories")
  Component(front, "ListFrontPageStoriesHandler", "MediatR handler", "Published stories: lead, headlines, river")
  Component(most, "ListMostReadStoriesHandler", "MediatR handler", "Five most read in the last 7 days")
  Component(ectrl, "PublicEventsController", "ASP.NET Core controller, AllowAnonymous", "GET /api/public/events/upcoming")
  Component(up, "GetUpcomingEventsHandler", "MediatR handler", "At most 4 published upcoming events")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Story, StoryReadTally, Event")

Rel(guard, page, "Lets a visitor through")
Rel(page, ui, "Renders")
Rel(page, rail, "Renders")
Rel(page, dom, "Uses")
Rel(page, stories, "Reads stories")
Rel(page, events, "Reads events")
Rel(stories, sctrl, "GET", "JSON/HTTPS")
Rel(events, ectrl, "GET", "JSON/HTTPS")
Rel(sctrl, front, "Sends ListFrontPageStoriesQuery")
Rel(sctrl, most, "Sends ListMostReadStoriesQuery")
Rel(ectrl, up, "Sends GetUpcomingEventsQuery")
Rel(front, db, "Reads Story", "EF Core")
Rel(most, db, "Reads StoryReadTally, Story", "EF Core")
Rel(up, db, "Reads Event", "EF Core")
@enduml
