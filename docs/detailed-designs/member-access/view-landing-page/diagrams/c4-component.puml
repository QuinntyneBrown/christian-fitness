@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the landing page

Container_Boundary(web, "Member web app") {
  Component(page, "LandingPage", "Angular routed component", "Hero, events list, verse, calls to action")
  Component(guard, "redirectSignedInGuard", "CanActivateFn", "Sends members to /home")
  Component(ui, "EventRow, Hero, Verse", "components library", "Presentation, BEM")
  Component(svc, "HttpPublicEventsService", "PUBLIC_EVENTS_SERVICE", "HTTP client")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "PublicEventsController", "ASP.NET Core controller", "[AllowAnonymous] GET /api/public/events/upcoming")
  Component(h, "GetUpcomingEventsHandler", "MediatR handler", "Published, upcoming, ordered, take 3")
  Component(ctx, "AppDbContext", "EF Core (IAppDbContext)", "Event set")
}
ContainerDb(db, "Christian Fitness database", "EF Core; engine <TO SUPPLY>", "Persistent store")

Rel(guard, page, "Allows visitors to")
Rel(page, ui, "Renders")
Rel(page, svc, "Requests next events")
Rel(svc, ctrl, "GET upcoming", "JSON/HTTPS")
Rel(ctrl, h, "Sends GetUpcomingEventsQuery")
Rel(h, ctx, "Queries Event")
Rel(ctx, db, "Reads", "EF Core")
@enduml
