@startuml
title UML sequence behaviour — Visitor opens the landing page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Member web app" #E0F2FE
  participant "redirectSignedInGuard" as guard
  participant "LandingPage" as page
  participant "HttpPublicEventsService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "PublicEventsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "GetUpcomingEventsHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> guard : Open /
guard -> guard : Read SESSION_SERVICE
alt Signed-in member (L2-001 AC4)
  guard --> actor : Redirect to /home
else Visitor
  guard -> page : Activate (loadComponent)
  page --> actor : Show skeleton rows
  page -> client : upcoming(3)
  client -> ctrl : GET /api/public/events/upcoming?take=3
  ctrl -> h : Send GetUpcomingEventsQuery (AllowAnonymous)
  h -> db : Published events with StartsAt > now, order by StartsAt, take 3
  db --> h : 0..3 rows
  h --> ctrl : UpcomingEventDto list
  ctrl --> client : 200 JSON
  client --> page : Events
  alt One to three events (L2-001 AC1, AC2)
    page --> actor : Render event rows in date order, no empty rows
  else No events (L2-001 AC3)
    page --> actor : "No events posted yet. Check back soon."
  end
end
@enduml
