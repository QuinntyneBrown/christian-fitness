@startuml
title UML sequence behaviour — Member chooses a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "HttpAccountService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AccountController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "CheckPasswordResetHandler" as ch
  participant "CompletePasswordResetHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "DatabaseSessionRevocation" as rev
  database "Christian Fitness database" as db
end box
actor -> page : Opens /reset-password#token=... from the email
page -> page : Read the token; replace the address with /reset-password (L2-045 AC1)
alt No token
  page --> actor : "This link has expired" (L2-045 AC4)
else Token
  page --> actor : "Checking your link..."
  page -> client : checkPasswordReset({ token })
  client -> ctrl : POST /api/account/password-reset/check (antiforgery token)
  ctrl -> ch : Send CheckPasswordResetQuery
  ch -> db : Find PasswordReset by SHA-256 of the token, and its Member
  alt Unknown, used or expired
    ch --> ctrl : RefusalException reset_link_expired (Gone)
    ctrl --> page : 410 reset_link_expired
    page --> actor : "This link has expired" with "Send a new link"
  else Usable
    ctrl --> page : 200 { email }
    page --> actor : "Choose a new password", "For" the email
    actor -> page : New password, typed twice; Save password
    alt Shorter than 8 or different (L2-045 AC5)
      page --> actor : Summary and field errors; nothing sent
    else Valid
      page -> client : completePasswordReset({ token, password })
      client -> ctrl : POST /api/account/password-reset/complete
      ctrl -> h : Send CompletePasswordResetCommand
      note over h : Validator: 400 validation_failed\nfor a password shorter than 8
      h -> db : Find PasswordReset by hash, and its Member
      alt Not usable
        h --> ctrl : RefusalException reset_link_expired
        ctrl --> page : 410; "This link has expired"
      else Usable
        h -> h : ChangePassword(PBKDF2 hash); Use(now) on every unused reset
        h -> rev : EndAllAsync(memberId)
        rev -> db : Remove the member's Sessions (not saved yet)
        h -> db : SaveChanges, one transaction; UsedAt is a concurrency token
        alt Another save used the link first (L2-045 AC7)
          db --> h : DbUpdateConcurrencyException
          h --> ctrl : RefusalException reset_link_expired
          ctrl --> page : 410; nothing of this save kept
        else Saved
          ctrl --> client : 204, no body (L2-045 AC2)
          client --> page : complete
          page --> actor : "Password saved", signed out everywhere, "Sign in" (L2-045 AC3)
        end
      end
    end
  end
end
@enduml
