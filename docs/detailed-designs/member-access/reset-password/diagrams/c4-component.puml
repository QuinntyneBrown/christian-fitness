@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Request a reset link

Container_Boundary(web, "Member web app") {
  Component(signin, "SignInPage", "Angular routed component", "Links to Forgot password")
  Component(page, "ForgotPasswordPage", "Angular routed component", "Email form and Check your email")
  Component(rules, "emailErrorOf / resetRequestRefusalOf", "domain helpers", "Email rule; what a failure shows")
  Component(svc, "HttpAccountService", "ACCOUNT_SERVICE", "HTTP client")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "AccountController", "ASP.NET Core controller", "POST /api/account/password-reset")
  Component(h, "RequestPasswordResetHandler", "MediatR handler", "Looks up, limits, issues, queues")
  Component(window, "AttemptWindow", "Domain rule", "N attempts within a period")
  Component(sender, "IEmailSender", "Application contract", "Queued SMTP; recording in development and tests")
  Component(dispatch, "EmailDispatcher", "BackgroundService", "Delivers queued mail")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Members, PasswordResets")
System_Ext(smtp, "Email service", "SMTP relay")

Rel(signin, page, "Forgot your password?")
Rel(page, rules, "Checks the email; reads failures")
Rel(page, svc, "requestPasswordReset")
Rel(svc, ctrl, "POST", "JSON/HTTPS")
Rel(ctrl, h, "Sends RequestPasswordResetCommand")
Rel(h, db, "Reads Member; counts and adds PasswordReset", "EF Core")
Rel(h, window, "Is the window full?")
Rel(h, sender, "Sends the reset email")
Rel(sender, dispatch, "Queues")
Rel(dispatch, smtp, "Delivers", "SMTP")
@enduml
