@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Create a member account

Person(user, "Visitor", "Person who is not signed in")
System_Boundary(cf, "Christian Fitness") {
  Container(web, "Member web app", "Angular (standalone, signals, zoneless)", "projects/web; member screens")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers and SignalR ChatHub")
  ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Members, events, registrations, conversations")
  Container(cli, "Christian Fitness CLI", ".NET console", "Migrations and idempotent seed")
}
System_Ext(google, "Google", "OpenID Connect provider")
System_Ext(otel, "OpenTelemetry collector", "Telemetry sink")

Rel(user, web, "Opens /join", "HTTPS")
Rel(web, api, "Posts the join form or Finish your profile; starts Google sign-up", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(cli, db, "Migrates and seeds", "EF Core")
Rel(user, google, "Is redirected to; returns to the API callback", "HTTPS")
Rel(api, google, "Exchanges code with PKCE; reads keys", "HTTPS")
Rel(api, otel, "Exports telemetry", "OTLP")
@enduml
