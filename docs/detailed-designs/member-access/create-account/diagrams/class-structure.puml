@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Create a member account
left to right direction
class JoinPage {
  +fullName: Signal<string>
  +email: Signal<string>
  +password: Signal<string>
  +homeChurch: Signal<string>
  +interests: Signal<string[]>
  +submitting: Signal<boolean>
  +fieldErrors: Signal<JoinFieldErrors>
  +refusal: Signal<JoinRefusal | null>
  +googleAccount: Signal<PendingGoogleAccountDto | null>
  +submit(): void
  +startGoogle(): void
}
class validateJoin <<domain helper>> {
  +validateJoin(form: JoinForm): JoinFieldErrors
}
class joinRefusalOf <<domain helper>> {
  +joinRefusalOf(error: ApiError): JoinRefusal
}
class ApiError {
  +status: number
  +code: string
  +errors?: Record<string, string[]>
}
interface AccountApi {
  +join(req: JoinRequestDto): Observable<SessionDto>
  +pendingGoogle(): Observable<PendingGoogleAccountDto>
  +joinWithGoogle(req: GoogleJoinRequestDto): Observable<SessionDto>
}
class PendingGoogleAccountDto {
  +email: string
  +name: string
}
class GoogleJoinRequestDto {
  +displayName: string
  +homeChurch: string | null
  +interests: string[]
}
class CreateGoogleAccountCommand {
  +string DisplayName
  +string? HomeChurch
  +IReadOnlyList<string> Interests
}
class CreateGoogleAccountValidator
class CreateGoogleAccountHandler {
  +Handle(c: CreateGoogleAccountCommand): Task<SessionDto>
}
class GetPendingGoogleAccountHandler
interface IGoogleIdentityReader {
  +ReadAsync(): Task<GoogleIdentity?>
  +ForgetAsync(): Task
}
class GoogleAccountMatch {
  +FindAsync(identity): Task<Member?>
}
class AccountCreationLimiter
class HttpAccountService
class JoinRequestDto {
  +fullName: string
  +email: string
  +password: string
  +homeChurch: string | null
  +interests: string[]
}
class SessionDto {
  +memberId: string
  +name: string
}
class AccountController {
  +Join(cmd: CreateAccountCommand): Task<IActionResult>
}
class CreateAccountCommand {
  +string FullName
  +string Email
  +string Password
  +string? HomeChurch
  +IReadOnlyList<string> Interests
}
class CreateAccountValidator {
  +rules: name, email, password, home church, interests
}
class ValidationBehavior<TRequest,TResponse>
class RefusalException {
  +string Code
  +RefusalKind Kind
}
class CreateAccountHandler {
  +Handle(c: CreateAccountCommand): Task<SessionDto>
}
class Member {
  +Guid Id
  +string Name
  +string Email
  +string NormalizedEmail
  +string PasswordHash
  +string? GoogleSubject
  +string? HomeChurch
  +IReadOnlyList<string> Interests
  +MemberStatus Status
  +DateTimeOffset JoinedAt
  +{static} JoinWithGoogle(name, email, subject, joinedAt, homeChurch, interests): Member
}
enum MemberStatus {
  Active
  Flagged
  Suspended
}
interface IPasswordHasherService {
  +Hash(password: string): string
}
interface ISessionSignIn {
  +SignInAsync(member: Member): Task
}
class CookieSessionSignIn
HttpAccountService ..|> AccountApi
CookieSessionSignIn ..|> ISessionSignIn
JoinPage ..> AccountApi : injects ACCOUNT_SERVICE
JoinPage ..> JoinRequestDto
JoinPage ..> validateJoin
JoinPage ..> joinRefusalOf
JoinPage ..> SessionApi : startGoogle, completeGoogle
interface SessionApi <<api>>
joinRefusalOf ..> ApiError
HttpAccountService ..> ApiError : errors with
ValidationBehavior ..> CreateAccountValidator : runs
CreateAccountHandler ..> RefusalException : throws email_taken
AccountApi ..> SessionDto
AccountController ..> CreateAccountCommand : sends
CreateAccountValidator ..> CreateAccountCommand : validates
CreateAccountHandler ..> CreateAccountCommand : handles
CreateAccountHandler ..> IPasswordHasherService
CreateAccountHandler ..> ISessionSignIn
CreateAccountHandler --> Member : creates
Member --> MemberStatus
AccountApi ..> PendingGoogleAccountDto
AccountApi ..> GoogleJoinRequestDto
AccountController ..> CreateGoogleAccountCommand : sends
CreateGoogleAccountValidator ..> CreateGoogleAccountCommand : validates
CreateGoogleAccountHandler ..> CreateGoogleAccountCommand : handles
CreateGoogleAccountHandler ..> IGoogleIdentityReader
GetPendingGoogleAccountHandler ..> IGoogleIdentityReader
CreateGoogleAccountHandler ..> AccountCreationLimiter
CreateGoogleAccountHandler ..> GoogleAccountMatch : signs in an existing account
CreateGoogleAccountHandler ..> ISessionSignIn
CreateGoogleAccountHandler --> Member : JoinWithGoogle
@enduml
