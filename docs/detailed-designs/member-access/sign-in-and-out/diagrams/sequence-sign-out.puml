@startuml
title UML sequence behaviour — Member signs out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "AppHeader" as header
  participant "MemberShell" as shell
  participant "HttpSessionService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "SessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SignOutHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "CookieSessionSignIn" as sess
end box
actor -> header : Choose Sign out (L2-008 AC4)
header -> shell : signOut
shell -> client : signOut()
client -> ctrl : DELETE /api/session with X-XSRF-TOKEN
ctrl -> h : Send SignOutCommand
h -> sess : SignOutAsync (L2-004 AC5)
sess --> h : Session cookie expired
h --> ctrl : Done
ctrl --> client : 204 + expired cookie and a visitor's token
alt 204, or 401 (the session had already ended)
  client --> shell : Signed out
  shell --> actor : Navigate to the landing page /
else Any other failure
  client --> shell : ApiError
  shell --> actor : Stay; Sign out can be chosen again
end
@enduml
