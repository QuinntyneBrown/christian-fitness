@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Sign in and sign out
package "Member web app and libraries" {
  class SignInPage {
    +email: Signal<string>
    +password: Signal<string>
    +submitting: Signal<boolean>
    +refusal: Signal<SignInRefusal|null>
    +submit(): void
  }
  class MemberShell {
    +signingOut: Signal<boolean>
    +signOut(): void
  }
  class AppHeader <<components>> {
    +homeHref: input<string>
    +signingOut: input<boolean>
    +signOut: output<void>
  }
  class memberAuthGuard <<domain, CanActivateFn>>
  class antiforgeryInterceptor <<domain, HttpInterceptorFn>>
  class signInRefusalOf <<domain>> {
    +(error): 'invalid-credentials'|'too-many-attempts'|'suspended'|'failed'
  }
  class signInReturnPathOf <<domain>> {
    +(value): string
  }
  interface SessionApi <<api>> {
    +current(): Observable<SessionDto>
    +signIn(request: SignInRequestDto): Observable<SessionDto>
    +signOut(): Observable<void>
  }
  class HttpSessionService
  class SignInRequestDto <<api>> {
    +email: string
    +password: string
  }
  class SessionDto <<api>> {
    +memberId: string
    +name: string
  }
}
package "Christian Fitness API, Application and Domain" {
  class SessionController {
    +SignIn(c: SignInCommand): Task<IActionResult>
    +SignOut(): Task<IActionResult>
    +Get(): Task<IActionResult>
  }
  class SignInCommand {
    +string Email
    +string Password
  }
  class SignInHandler {
    +Handle(c: SignInCommand): Task<SessionDto>
  }
  class MemberCredentials {
    +VerifyAsync(email, password): Task<Member>
  }
  class SignOutCommand
  class SignOutHandler
  interface ISessionSignIn {
    +SignInAsync(member: Member): Task
    +SignOutAsync(): Task
  }
  interface IPasswordHasherService {
    +Verify(hash: string, password: string): bool
  }
  class SignInFailure {
    +Guid Id
    +string EmailKey
    +DateTimeOffset FailedAt
  }
  class TimeProvider
  class Member {
    +Guid Id
    +string NormalizedEmail
    +string PasswordHash
    +MemberStatus Status
  }
  enum MemberStatus {
    Active
    Flagged
    Suspended
  }
}
HttpSessionService ..|> SessionApi
SignInPage ..> SessionApi : injects SESSION_SERVICE
SignInPage ..> signInRefusalOf
SignInPage ..> signInReturnPathOf : returnUrl
MemberShell --> AppHeader
MemberShell ..> SessionApi : signOut()
memberAuthGuard ..> SessionApi : current()
SessionApi ..> SignInRequestDto
SessionApi ..> SessionDto
SessionController ..> SignInCommand : sends
SessionController ..> SignOutCommand : sends
SignInHandler ..> SignInCommand : handles
SignOutHandler ..> SignOutCommand : handles
SignInHandler ..> MemberCredentials : verifies
MemberCredentials ..> IPasswordHasherService : verifies
SignInHandler ..> ISessionSignIn : signs in
SignOutHandler ..> ISessionSignIn : signs out
MemberCredentials ..> Member : loads by NormalizedEmail
SignInHandler ..> SignInFailure : counts last 15 min, records, clears
SignInHandler ..> TimeProvider : now
Member --> MemberStatus
@enduml
