@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in and sign out

Container_Boundary(web, "Member web app") {
  Component(page, "SignInPage", "Angular routed component", "Credentials form")
  Component(guard, "memberAuthGuard", "CanActivateFn", "Protects member routes")
  Component(svc, "HttpSessionService", "SESSION_SERVICE", "Session signal and HTTP client")
}
Container_Boundary(api, "Christian Fitness API") {
  Component(ctrl, "SessionController", "ASP.NET Core controller", "POST, GET, DELETE /api/session")
  Component(h, "SignInHandler", "MediatR handler", "Rate window, password, status")
  Component(o, "SignOutHandler", "MediatR handler", "Ends session")
  Component(hash, "IPasswordHasher", "Infrastructure", "Verifies hash")
  Component(sess, "CookieSessionSignIn", "Infrastructure", "Cookie auth")
}
ContainerDb(db, "Christian Fitness database", "EF Core; PostgreSQL", "Persistent store")

Rel(guard, svc, "Reads session")
Rel(page, svc, "Signs in / out")
Rel(svc, ctrl, "Session calls", "JSON/HTTPS")
Rel(ctrl, h, "Sends SignInCommand")
Rel(ctrl, o, "Sends SignOutCommand")
Rel(h, hash, "Verifies password")
Rel(h, db, "Reads Member, SignInAttempt", "EF Core")
Rel(ctrl, sess, "Issues or clears cookie")
@enduml
