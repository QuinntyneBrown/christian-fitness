@startuml
title UML sequence behaviour — Member signs in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "memberAuthGuard" as guard
  participant "SignInPage" as page
  participant "HttpSessionService" as client
  participant "antiforgeryInterceptor" as xsrf
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "SessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SignInHandler" as h
  participant "MemberCredentials" as cred
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "IPasswordHasherService" as hash
  participant "CookieSessionSignIn" as sess
  database "Christian Fitness database" as db
end box
actor -> guard : Open a member route
guard -> client : current()
client --> guard : 401 unauthenticated
guard --> actor : Redirect to /sign-in?returnUrl=<route asked for> (L2-004 AC6)
actor -> page : Submit email and password
page -> client : signIn({ email, password })
client -> xsrf : POST /api/session
opt No __Host-cf-xsrf cookie yet
  xsrf -> ctrl : GET /api/antiforgery
  ctrl --> xsrf : 204 + __Host-cf-antiforgery and __Host-cf-xsrf
end
xsrf -> ctrl : POST /api/session with X-XSRF-TOKEN
ctrl -> h : Send SignInCommand
h -> db : Count SignInFailure for the email key\nsince now - 15 min (TimeProvider)
db --> h : Failures in the window
alt 5 or more failures in the window (L2-004 AC3)
  h --> ctrl : RefusalException too_many_attempts (not recorded)
  ctrl --> client : 429 ProblemDetails code too_many_attempts
  client --> page : ApiError
  page --> actor : "Sign-in paused for 15 minutes"
end
h -> cred : VerifyAsync(email, password)
cred -> db : Load Member by NormalizedEmail
db --> cred : Member or none
cred -> hash : Verify password (a fixed hash when none)
hash --> cred : Match result
cred --> h : Member, or RefusalException invalid_credentials
alt Unknown email or wrong password (L2-004 AC2)
  h -> db : Delete failures older than the window;\nadd SignInFailure (email key, now)
  h --> ctrl : RefusalException invalid_credentials
  ctrl --> client : 401 ProblemDetails code invalid_credentials
  client --> page : ApiError
  page --> actor : "Email or password is incorrect"
else Right password, member suspended (L2-004 AC4)
  h --> ctrl : RefusalException account_suspended
  ctrl --> client : 403 ProblemDetails code account_suspended
  client --> page : ApiError
  page --> actor : "Your account is suspended" and contact the team
else Valid
  h -> db : Delete the email's failures
  h -> sess : SignInAsync(member)
  sess --> h : __Host-cf-session, Secure, HttpOnly, SameSite=Lax (L2-004 AC1)
  h --> ctrl : SessionDto
  ctrl --> client : 200 SessionDto + Set-Cookie (session and a fresh token)
  client --> page : Session
  page --> actor : Navigate to returnUrl if it is a path in the app, else Home (L2-004 AC6)
end
@enduml
