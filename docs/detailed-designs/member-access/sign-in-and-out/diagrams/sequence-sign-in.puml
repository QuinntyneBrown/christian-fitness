@startuml
title UML sequence behaviour — Member signs in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "memberAuthGuard" as guard
  participant "SignInPage" as page
  participant "HttpSessionService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "SessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SignInHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "IPasswordHasher" as hash
  participant "CookieSessionSignIn" as sess
  database "Christian Fitness database" as db
end box
actor -> guard : Open a member route
guard -> client : current()
client --> guard : No session
guard --> actor : Redirect to /sign-in?returnUrl (L2-004 AC6)
actor -> page : Submit email and password
page -> client : signIn(email, password)
client -> ctrl : POST /api/session
ctrl -> h : Send SignInCommand
h -> db : Count SignInAttempt for email in last 15 min
db --> h : Count
alt 5 or more failures (L2-004 AC3)
  h --> ctrl : too_many_attempts
  ctrl --> client : 429 ProblemDetails code too_many_attempts
  client --> page : Error code
  page --> actor : Try again later
else Under the limit
  h -> db : Load Member by NormalizedEmail
  db --> h : Member or none
  h -> hash : Verify password
  hash --> h : Match result
  alt Unknown email or wrong password (L2-004 AC2)
    h -> db : Record SignInAttempt
    h --> ctrl : invalid_credentials
    ctrl --> client : 401 ProblemDetails code invalid_credentials
    client --> page : Error code
    page --> actor : "Email or password is incorrect"
  else Member suspended (L2-004 AC4)
    h --> ctrl : account_suspended
    ctrl --> client : 403 ProblemDetails code account_suspended
    client --> page : Error code
    page --> actor : Contact the team
  else Valid
    h --> ctrl : SessionDto
    ctrl -> sess : Sign in
    sess --> ctrl : Secure HTTP-only SameSite cookie (L2-004 AC1)
    ctrl --> client : 200 SessionDto + Set-Cookie
    client --> page : Session
    page --> actor : Navigate to returnUrl or Home
  end
end
@enduml
