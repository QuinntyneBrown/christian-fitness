@startuml
title UML sequence behaviour — Refuse an invalid body
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "JoinPage" as page
  participant "HttpAccountService" as http
  participant "joinRefusalOf()" as msg
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AccountController" as ctrl
  participant "ProblemDetailsExceptionHandler" as eh
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "ValidationBehavior" as vb
  participant "CreateAccountValidator" as v
end box
actor -> page : Submit a body the form's own checks let through (rules differ, or made by hand)
page -> http : join(dto)
http -> ctrl : POST /api/account/join
ctrl -> vb : Send CreateAccountCommand
vb -> v : Validate
v --> vb : failures { email }
vb --> eh : ValidationException
eh --> http : 400 ProblemDetails code validation_failed or field_too_long, errors (L2-032 AC1)
http --> page : ApiError (apiErrorOf)
page -> msg : joinRefusalOf(error)
msg --> page : refused
page --> actor : Generic "Check your details" form-alert; everything typed stays
@enduml
