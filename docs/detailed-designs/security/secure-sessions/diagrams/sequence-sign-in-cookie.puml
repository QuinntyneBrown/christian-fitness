@startuml
title UML sequence behaviour — Sign in and receive a secure session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "SignInPage" as page
  participant "HttpClient (XSRF)" as http
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "SecurityHeadersMiddleware" as hdr
  participant "AuthController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SignInHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "PasswordHasher<Member>" as hash
  database "Christian Fitness database" as db
end box
actor -> page : Submit email and password
page -> http : POST /api/auth/sign-in
http -> hdr : HTTPS request with X-XSRF-TOKEN
hdr -> ctrl : Antiforgery token valid (L2-030 AC3)
ctrl -> h : Send SignInCommand
h -> db : Load Member by email
db --> h : Member with PasswordHash
h -> hash : VerifyHashedPassword (PBKDF2, L2-030 AC1)
hash --> h : Success
h --> ctrl : SignInResult (no password field)
ctrl -> ctrl : SignInAsync: __Host-cf-session, Secure, HttpOnly, SameSite=Lax (L2-030 AC2)
ctrl --> hdr : 200 with Set-Cookie
hdr --> http : Add CSP, nosniff, Referrer-Policy, HSTS in production (L2-030 AC4)
http --> page : Signed in
page --> actor : Navigate to Home
@enduml
