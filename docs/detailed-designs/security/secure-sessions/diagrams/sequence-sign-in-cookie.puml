@startuml
title UML sequence behaviour — Sign in and receive a secure session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Member web app" #E0F2FE
  participant "SignInPage" as page
  participant "HttpClient (XSRF)" as http
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "SecurityHeadersMiddleware" as hdr
  participant "AntiforgeryTokenMiddleware" as tok
  participant "SessionController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "SignInHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  participant "IdentityPasswordHasher" as hash
  participant "CookieSessionSignIn" as sess
  database "Christian Fitness database" as db
end box
actor -> page : Submit email and password
page -> http : POST /api/session
http -> hdr : HTTPS request with X-XSRF-TOKEN
hdr -> tok : Pass request
tok -> ctrl : Antiforgery token valid (L2-030 AC3)
ctrl -> h : Send SignInCommand
h -> db : Load Member by NormalizedEmail
db --> h : Member with PasswordHash
h -> hash : Verify (PBKDF2, L2-030 AC1)
hash --> h : Success
h -> sess : SignInAsync(member)
sess --> h : __Host-cf-session, Secure, HttpOnly, SameSite=Lax (L2-030 AC2)
h --> ctrl : SessionDto (no password field)
ctrl --> tok : 200
tok --> hdr : Set-Cookie __Host-cf-xsrf for the signed-in member
hdr --> http : Add CSP, nosniff, Referrer-Policy, HSTS outside Development (L2-030 AC4)
http --> page : Signed in
page --> actor : Navigate to Home
@enduml
