@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Secure sessions

class Member {
  +Guid Id
  +string Email
  +string PasswordHash
  +MemberStatus Status
}
interface IPasswordHasherService {
  +Hash(password: string): string
  +Verify(passwordHash: string, password: string): bool
}
class IdentityPasswordHasher {
  -PasswordHasher<Member> hasher
}
interface ISessionSignIn {
  +SignInAsync(member: Member): Task
  +SignOutAsync(): Task
}
class CookieSessionSignIn {
  sets HttpContext.User to the new identity
}
class SignInHandler {
  +Handle(c: SignInCommand): Task<SessionDto>
}
class CreateAccountHandler {
  +Handle(c: CreateAccountCommand): Task<SessionDto>
}
class SessionDto {
  +Guid MemberId
  +string Name
}
class AuthenticationSetup {
  +SessionCookie = "__Host-cf-session"
  +SameSite = Lax
  +SecurePolicy = Always
  +HttpOnly = true
}
class AntiforgerySetup {
  +Cookie = "__Host-cf-antiforgery"
  +TokenCookie = "__Host-cf-xsrf"
  +Header = "X-XSRF-TOKEN"
}
class AntiforgeryTokenMiddleware {
  +InvokeAsync(ctx: HttpContext): Task
}
class AntiforgeryRefusalFilter {
  400 code antiforgery_failed
}
class SecurityHeadersMiddleware {
  +InvokeAsync(ctx: HttpContext): Task
}
IdentityPasswordHasher ..|> IPasswordHasherService
CookieSessionSignIn ..|> ISessionSignIn
SignInHandler ..> IPasswordHasherService : verifies
CreateAccountHandler ..> IPasswordHasherService : hashes
SignInHandler ..> ISessionSignIn
CreateAccountHandler ..> ISessionSignIn
SignInHandler ..> SessionDto : returns
CreateAccountHandler ..> SessionDto : returns
SignInHandler --> Member : loads
AntiforgerySetup ..> AntiforgeryTokenMiddleware : registers
AntiforgerySetup ..> AntiforgeryRefusalFilter : registers
@enduml
