@startuml
title UML sequence behaviour — Refuse a call without a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Member web app" #E0F2FE
  participant "HttpXxxService" as http
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "Authorization middleware" as authz
  participant "Controller" as ctrl
end box
actor -> http : Open a member route's data
http -> authz : GET /api/registrations (no cookie)
alt endpoint has [AllowAnonymous] (landing, join, sign-in, health)
  authz -> ctrl : Pass request
  ctrl --> http : 200
else any other endpoint
  authz --> http : 401 ProblemDetails (L2-031 AC1)
end
http --> actor : Guard redirects to sign-in (L2-004 AC6)
@enduml
