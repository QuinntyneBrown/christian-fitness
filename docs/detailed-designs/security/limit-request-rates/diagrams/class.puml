@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Limit request rates

class MessageRateLimiter {
  +Limit = 30
  +Window = 1 minute
  -TimeProvider clock
  +IsAllowedAsync(memberId: Guid): Task<bool>
}
class SendMessageHandler {
  +Handle(c: SendMessageCommand): Task<SendResult>
}
class SendResult {
  +bool Ok
  +string? Code
  +MessageDto? Message
}
abstract class AddressRateLimiter {
  +Limit: int
  +Window: TimeSpan
  -TimeProvider clock
  +TryAcquire(address: string): Lease?
  +Release(lease: Lease): void
}
class AccountCreationLimiter {
  +Limit = 5
  +Window = 1 hour
}
class PasswordResetRequestLimiter {
  +Limit = 10
  +Window = 1 hour
}
class RequestPasswordResetHandler {
  +Handle(c: RequestPasswordResetCommand): Task
}
AddressRateLimiter <|-- AccountCreationLimiter
AddressRateLimiter <|-- PasswordResetRequestLimiter
interface IClientAddress {
  +PartitionKey: string
}
class CreateAccountHandler {
  +Handle(c: CreateAccountCommand): Task<SessionDto>
}
SendMessageHandler ..> MessageRateLimiter
SendMessageHandler ..> SendResult
CreateAccountHandler ..> AccountCreationLimiter
CreateAccountHandler ..> IClientAddress
RequestPasswordResetHandler ..> PasswordResetRequestLimiter
RequestPasswordResetHandler ..> IClientAddress
@enduml
