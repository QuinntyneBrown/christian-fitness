@startuml
title UML sequence behaviour — Refuse the 6th account creation from one address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Member web app" #E0F2FE
  participant "JoinPage" as page
  participant "HttpAccountService" as http
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "Rate limiting middleware" as mw
  participant "AuthController" as ctrl
end box
actor -> page : Submit join form
page -> http : join(dto)
http -> mw : POST /api/auth/join
alt fewer than 5 creations from this IP in the hour
  mw -> ctrl : Pass request
  ctrl --> http : 201
else limit reached
  mw --> http : 429 ProblemDetails code rate_limited (L2-034 AC2)
  http --> page : ApiError
  page --> actor : Generic message
end
@enduml
