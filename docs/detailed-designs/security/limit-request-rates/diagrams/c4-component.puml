@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Limit request rates

Container(web, "Member web app", "Angular", "ChatStore, JoinPage")
Container_Boundary(api, "Christian Fitness API") {
  Component(hub, "ChatHub", "SignalR hub", "SendMessage -> one MediatR send")
  Component(h, "SendMessageHandler", "MediatR", "Participant check, rate check, save")
  Component(rl, "MessageRateLimiter", "Domain service", "30 per member per minute")
  Component(ctrl, "AccountController.Join", "Controller", "One MediatR send")
  Component(ch, "CreateAccountHandler", "MediatR", "Lease, email check, save")
  Component(al, "AccountCreationLimiter", "Application singleton", "5 per client address per hour, in memory")
  Component(ca, "HttpClientAddress", "Infrastructure", "IPv4 or IPv6 /64 of the peer")
  ComponentDb(db, "Christian Fitness database", "EF Core", "Messages")
}
Rel(web, hub, "SendMessage", "SignalR")
Rel(hub, h, "Sends command")
Rel(h, rl, "Checks")
Rel(rl, db, "Counts recent messages")
Rel(web, ctrl, "POST /api/account/join", "JSON/HTTPS")
Rel(ctrl, ch, "Sends CreateAccountCommand")
Rel(ch, ca, "Reads the client address")
Rel(ch, al, "TryAcquire / Release")
@enduml
