@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Load fast

Person(visitor, "Visitor", "Not signed in")
Person(staff, "Staff member", "Admin or Moderator")
System_Boundary(cf, "Christian Fitness") {
  Container(web, "Member web app", "Angular (standalone, signals, zoneless)", "projects/web")
  Container(admin, "Admin web app", "Angular (standalone, signals, zoneless)", "projects/admin")
  Container(api, "Christian Fitness API", "ASP.NET Core", "Controllers and SignalR ChatHub")
}

Rel(visitor, web, "Loads initial chunk, then route chunks", "HTTPS")
Rel(staff, admin, "Loads initial chunk, then route chunks", "HTTPS")
Rel(web, api, "Fetches landing data", "JSON/HTTPS")
@enduml
