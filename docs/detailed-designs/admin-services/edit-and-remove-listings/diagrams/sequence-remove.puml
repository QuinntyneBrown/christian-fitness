@startuml
title UML sequence behaviour — Remove a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Staff member (Admin)" as actor
box "Frontend — Admin web app" #E0F2FE
  participant "ManageServicesPage" as page
  participant "ListingEditorDialog" as dlg
  participant "HttpAdminServicesService" as client
end box
box "Backend — Christian Fitness API" #D1FADF
  participant "AdminListingsController" as ctrl
end box
box "Backend — Christian Fitness Application and Domain" #ECFDF3
  participant "RemoveListingHandler" as h
end box
box "Backend — Christian Fitness Infrastructure" #FFF4E5
  database "Christian Fitness database" as db
end box
actor -> dlg : Remove listing
dlg --> actor : Ask for confirmation
actor -> dlg : Confirm
dlg -> client : removeListing(id)
client -> ctrl : DELETE /api/admin/listings/{id}
ctrl -> ctrl : Authenticate and apply AdminOnly policy
ctrl -> h : Send RemoveListingCommand
h -> db : Load listing
alt listing missing
  db --> h : None
  h --> ctrl : Refuse service_not_found
  ctrl --> client : 404 ProblemDetails (code service_not_found)
  client --> dlg : Error code
  dlg --> actor : Generic message
else listing found
  db --> h : Listing
  h -> db : Delete ServiceListing row (hard delete, ADR 0055)
  h -> db : Add audit entry listing.removed
  h -> db : Save changes in one unit of work
  db --> h : Committed
  note right of h : Conversations and messages untouched (L2-027 AC2)
  h --> ctrl : Success
  ctrl --> client : 204 No Content
  client --> dlg : Done
  dlg -> dlg : Close by its ref
  dlg --> page : Removed
  page --> actor : Listing leaves Live listings; Services no longer shows it
  note over actor, db : Any later call on the removed id answers 404 service_not_found
end
@enduml
